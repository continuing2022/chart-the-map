<view class="tabbar-safe-area">
  <view class="tabbar-shell">
    <view
      wx:for="{{tabs}}"
      wx:key="pagePath"
      class="tab {{selected === item.index ? 'active' : ''}}"
      hover-class="tab-pressed"
      data-index="{{item.index}}"
      data-path="{{item.pagePath}}"
      bindtap="switchTab"
      aria-role="button"
      aria-label="切换到{{item.text}}"
    >
      <image class="tab-icon" src="/assets/icons/{{item.icon}}{{selected === item.index ? '-active' : ''}}.svg" mode="aspectFit" aria-hidden="true" />
      <text class="tab-label">{{item.text}}</text>
    </view>
  </view>
</view>
