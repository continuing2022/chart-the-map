.tabbar-safe-area {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 0 30rpx calc(20rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tabbar-shell {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 10rpx;
  border: 1rpx solid rgba(70, 58, 49, .05);
  border-radius: 38rpx;
  background: rgba(255, 255, 255, .96);
  box-shadow: 0 14rpx 46rpx rgba(69, 53, 42, .13);
  backdrop-filter: blur(18rpx);
  pointer-events: auto;
}

.tab {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 88rpx;
  flex: 1;
  flex-direction: column;
  border-radius: 29rpx;
  color: #7d7d7d;
  font-size: 23rpx;
  transition: opacity .15s ease, transform .15s ease, background-color .15s ease;
}

.tab.active {
  color: #d94b43;
  background: linear-gradient(105deg, #fdebea, #fce5e3);
  font-weight: 650;
}

.tab-pressed {
  opacity: .66;
  transform: scale(.985);
}

.tab-icon {
  position: relative;
  width: 42rpx;
  height: 39rpx;
  margin-bottom: 3rpx;
  color: currentColor;
}

.home-roof {
  position: absolute;
  top: 3rpx;
  left: 8rpx;
  width: 25rpx;
  height: 25rpx;
  border-top: 6rpx solid currentColor;
  border-left: 6rpx solid currentColor;
  border-radius: 4rpx;
  transform: rotate(45deg);
}

.home-body {
  position: absolute;
  right: 7rpx;
  bottom: 1rpx;
  left: 7rpx;
  height: 23rpx;
  border-radius: 5rpx;
  background: currentColor;
}

.home-body::after {
  position: absolute;
  bottom: 0;
  left: 12rpx;
  width: 8rpx;
  height: 14rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: #fff;
  content: '';
}

.active .home-body::after {
  background: #fde8e6;
}

.calendar-body {
  position: absolute;
  top: 4rpx;
  left: 5rpx;
  box-sizing: border-box;
  width: 33rpx;
  height: 33rpx;
  border: 4rpx solid currentColor;
  border-radius: 6rpx;
}

.calendar-body::before {
  position: absolute;
  top: 7rpx;
  right: 0;
  left: 0;
  height: 3rpx;
  background: currentColor;
  content: '';
}

.calendar-rings {
  position: absolute;
  top: -8rpx;
  right: 5rpx;
  left: 5rpx;
  display: flex;
  justify-content: space-between;
}

.calendar-rings text {
  width: 4rpx;
  height: 9rpx;
  border-radius: 4rpx;
  background: currentColor;
}

.calendar-dots {
  position: absolute;
  top: 15rpx;
  right: 5rpx;
  left: 5rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 4rpx;
}

.calendar-dots text {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: currentColor;
}

.tab-label {
  line-height: 1.25;
}
