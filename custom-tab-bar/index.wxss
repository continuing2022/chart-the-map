@import "../styles/design-system.wxss";
.tabbar-safe-area {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 0 var(--gutter) calc(16rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tabbar-shell {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 8rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background: var(--glass);
  box-shadow: var(--float-shadow);
  backdrop-filter: blur(12px);
  pointer-events: auto;
}

.tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  flex: 1;
  border-radius: 999rpx;
  color: var(--muted);
}

.tab.active {
  color: var(--brand);
  background: var(--brand-soft);
  font-weight: 600;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
}

.tab-label {
  font-size: 26rpx;
  line-height: 1.3;
}

.tab-pressed {
  opacity: .65;
}
