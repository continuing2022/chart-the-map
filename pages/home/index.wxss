.page { padding: 52rpx 32rpx 150rpx; }
.topbar { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40rpx; }
.eyebrow { color: #8e8e93; font-size: 24rpx; letter-spacing: 1rpx; }
.title { margin-top: 4rpx; font-size: 54rpx; font-weight: 700; letter-spacing: -2rpx; }
.date { margin-top: 10rpx; color: #6e6e73; font-size: 26rpx; }
.settings { width: 64rpx; height: 64rpx; border-radius: 32rpx; background: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(0,0,0,.06); font-size: 32rpx; }
.recap-card { display: flex; align-items: center; background: #ecf2ff; border-radius: 28rpx; padding: 24rpx; margin-bottom: 42rpx; }
.recap-icon { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: #fff; color: #5878d6; }
.recap-copy { flex: 1; margin-left: 18rpx; }.recap-title { font-size: 28rpx; font-weight: 600; }.recap-body { margin-top: 4rpx; color: #6e6e73; font-size: 22rpx; }.recap-arrow,.chevron { color: #8e8e93; font-size: 42rpx; }
.section-title { margin-bottom: 20rpx; font-size: 32rpx; font-weight: 700; }.meal-card { border-radius: 30rpx; margin-bottom: 20rpx; padding: 24rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(0,0,0,.04); }.meal-card.empty { background: #fcfcfd; border: 2rpx dashed #dedee5; box-shadow: none; }
.slot-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18rpx; }.slot-name { font-size: 29rpx; font-weight: 600; }.status,.mock-badge { color: #667085; background: #f1f2f5; padding: 5rpx 12rpx; border-radius: 16rpx; font-size: 20rpx; }.record-row,.empty-row { display: flex; align-items: center; }.meal-image { width: 122rpx; height: 122rpx; border-radius: 22rpx; background: #f0f0f0; }.record-copy { flex: 1; margin-left: 20rpx; }.record-title { font-size: 28rpx; font-weight: 600; }.record-subtitle { margin: 9rpx 0; color: #8e8e93; font-size: 22rpx; }.mock-badge { display: inline-block; color: #7563af; background: #f0edff; }.empty-row { min-height: 88rpx; color: #8e8e93; font-size: 26rpx; }.plus { margin-right: 14rpx; color: #5574cc; font-size: 44rpx; font-weight: 300; }.tabbar { position: fixed; left: 32rpx; right: 32rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); display: flex; padding: 10rpx; border-radius: 28rpx; background: rgba(255,255,255,.94); box-shadow: 0 12rpx 36rpx rgba(0,0,0,.10); }.tab { flex: 1; padding: 18rpx; text-align: center; color: #8e8e93; font-size: 26rpx; }.tab.active { border-radius: 20rpx; color: #1d1d1f; background: #f1f1f4; font-weight: 600; }
