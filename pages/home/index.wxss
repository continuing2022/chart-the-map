.page {
  box-sizing: border-box;
  min-height: calc(100vh - var(--navigation-total));
  padding: 32rpx var(--gutter) calc(152rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

.day-journal {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-section);
}

.day-copy {
  min-width: 0;
}

.date-line {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.date-title {
  font-size: var(--text-page);
  font-weight: 650;
  letter-spacing: -2rpx;
  line-height: 1.2;
}

.weekday {
  margin-left: 18rpx;
  color: var(--muted);
  font-size: var(--text-caption);
}

.greeting {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: var(--text-body);
}

.journal-quote {
  flex: none;
  margin-left: 12rpx;
  color: var(--quiet);
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 22rpx;
  line-height: 1.7;
  text-align: right;
  transform: rotate(-4deg);
}

.recap-card {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 108rpx;
  margin-bottom: var(--space-section);
  padding: 14rpx 18rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-card);
  background: var(--glass);
  box-shadow: 0 6rpx 24rpx rgba(75, 58, 43, .04);
  backdrop-filter: blur(8px);
}

.recap-polaroid {
  width: 76rpx;
  height: 80rpx;
  box-sizing: border-box;
  padding: 5rpx 5rpx 12rpx;
  margin-right: 20rpx;
  flex: none;
  border-radius: 8rpx;
  background: var(--surface);
  transform: rotate(-4deg);
}

.recap-photo {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 4rpx;
}

.recap-copy {
  min-width: 0;
  flex: 1;
}

.recap-eyebrow {
  color: var(--quiet);
  font-size: 18rpx;
  letter-spacing: 3rpx;
  line-height: 1.2;
}

.recap-title {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
}

.recap-body {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.4;
}

.recap-arrow {
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-content);
}

.section-title {
  font-size: var(--text-section);
  font-weight: 600;
  letter-spacing: -1rpx;
}

.section-note {
  margin-left: 12rpx;
  color: var(--quiet);
  font-size: 22rpx;
}

.slot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  align-items: stretch;
}

.meal-card {
  box-sizing: border-box;
  width: calc(50% - 12rpx);
  min-width: 0;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-card);
  background: var(--surface);
}

.record-row, .empty-row {
  height: 100%;
}

.record-image-wrap, .meal-art-shell {
  position: relative;
  width: 100%;
  height: calc((100vw - 112rpx) / 2 - 2rpx);
  overflow: hidden;
}

.meal-image {
  display: block;
  width: 100%;
  height: 100%;
}

.meal-art-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f0e7;
}

.meal-lunch .meal-art-shell {
  background: #f0f2e9;
}

.meal-dinner .meal-art-shell {
  background: #f8eeea;
}

.meal-lateNight .meal-art-shell {
  background: var(--surface);
}

.meal-illustration {
  width: 84%;
  height: 84%;
  opacity: .88;
}

.record-copy, .empty-meta {
  padding: 14rpx 20rpx 20rpx;
}

.record-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-title, .slot-name {
  font-size: var(--text-card);
  font-weight: 600;
  line-height: 1.4;
}

.more-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  margin: -12rpx -14rpx -12rpx 0;
  flex: none;
}

.more-button .ui-icon {
  width: 32rpx;
  height: 32rpx;
}

.status-line {
  display: flex;
  align-items: baseline;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: var(--text-caption);
  line-height: 1.4;
}

.status-mark {
  margin-right: 8rpx;
  color: var(--success);
  flex: none;
}

.status-failed, .status-failed .status-mark {
  color: var(--danger);
}

.status-processing .status-mark {
  color: var(--accent);
}

.mock-note {
  margin-top: 4rpx;
  color: var(--quiet);
  font-size: 20rpx;
}

.empty-prompt {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.4;
}

.plus {
  margin-right: 6rpx;
  color: var(--muted);
  font-size: 28rpx;
}

@media (max-width: 340px) {
  .journal-quote {
    display: none;
  }

  .section-note {
    display: none;
  }

  .record-copy, .empty-meta {
    padding-right: 16rpx;
    padding-left: 16rpx;
  }

}
