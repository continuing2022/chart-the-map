.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 42rpx 34rpx 184rpx;
  padding-bottom: calc(184rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background:
    radial-gradient(circle at 92% 8%, rgba(255, 189, 126, .11), transparent 28%),
    linear-gradient(180deg, #fffcf8 0%, #fffaf4 100%);
}

.brand-row,
.day-overview,
.date-line,
.section-heading,
.record-heading,
.empty-prompt,
.tabbar,
.tab {
  display: flex;
  align-items: center;
}

.brand-row {
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 52rpx;
}

.brand-block {
  position: relative;
  padding-left: 4rpx;
}

.brand-title {
  position: relative;
  z-index: 1;
  color: #332722;
  font-family: "STKaiti", "KaiTi", "PingFang SC", sans-serif;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.04;
  letter-spacing: 2rpx;
}

.brand-rays {
  display: inline-block;
  margin-left: 8rpx;
  color: #ffa13d;
  font-size: 28rpx;
  vertical-align: top;
  transform: rotate(10deg);
}

.brand-underline {
  width: 258rpx;
  height: 18rpx;
  margin-top: -12rpx;
  border-radius: 50%;
  background: rgba(245, 126, 119, .28);
  transform: rotate(-2deg);
}

.brand-subtitle {
  margin-top: 8rpx;
  padding-left: 16rpx;
  color: #665b56;
  font-size: 22rpx;
  letter-spacing: 12rpx;
}

.settings {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-top: 2rpx;
  border-radius: 38rpx;
  color: #626364;
}

.settings-icon {
  font-size: 47rpx;
  line-height: 1;
}

.day-overview {
  justify-content: space-between;
  margin-bottom: 36rpx;
  padding: 0 8rpx;
}

.date-line {
  align-items: baseline;
}

.date-title {
  color: #151515;
  font-size: 43rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.weekday {
  margin-left: 25rpx;
  color: #797979;
  font-size: 27rpx;
  font-weight: 500;
}

.greeting {
  margin-top: 15rpx;
  color: #858585;
  font-size: 26rpx;
}

.greeting-sun {
  margin-right: 14rpx;
  color: #ffa13d;
  font-size: 30rpx;
}

.weather-art {
  padding-right: 10rpx;
  color: #ffa13d;
  font-size: 70rpx;
  font-weight: 300;
  line-height: 1;
}

.recap-card {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 98rpx;
  margin-bottom: 44rpx;
  padding: 24rpx 126rpx 24rpx 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(153, 195, 233, .18);
  border-radius: 30rpx;
  background: linear-gradient(105deg, #e5f2ff 0%, #dceeff 100%);
  color: #173b6b;
}

.recap-copy {
  min-width: 0;
  flex: 1;
}

.recap-title {
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.45;
}

.recap-body {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.recap-arrow {
  margin-left: 12rpx;
  font-size: 42rpx;
  font-weight: 300;
}

.recap-mascot {
  position: absolute;
  right: 15rpx;
  bottom: -4rpx;
  font-size: 66rpx;
  transform: rotate(-4deg);
}

.recap-mascot text {
  position: absolute;
  top: -12rpx;
  left: -10rpx;
  color: #cf8272;
  font-size: 23rpx;
}

.section-heading {
  justify-content: space-between;
  align-items: flex-end;
  margin: 0 6rpx 24rpx;
}

.section-title {
  color: #151515;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.section-note {
  color: #9a685a;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 21rpx;
  line-height: 1.45;
  text-align: right;
  transform: rotate(-4deg);
}

.section-note text {
  margin-left: 4rpx;
}

.slot-list.is-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.meal-card {
  box-sizing: border-box;
  min-width: 0;
}

.is-grid .meal-card.empty {
  width: calc(50% - 10rpx);
  min-height: 278rpx;
  margin-bottom: 20rpx;
}

.meal-card.empty {
  border: 2rpx dashed #d5d2ce;
  border-radius: 31rpx;
  background: rgba(255, 255, 255, .24);
}

.is-grid .empty-row {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 274rpx;
  padding: 24rpx 18rpx;
  text-align: center;
}

.meal-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  font-size: 57rpx;
  line-height: 1;
}

.icon-sunrise,
.icon-lunch {
  color: #ffa13d;
}

.icon-dinner {
  color: #ff8064;
}

.icon-late-night {
  color: #8c8be6;
}

.slot-name {
  color: #171717;
  font-size: 29rpx;
  font-weight: 700;
}

.is-grid .slot-name {
  margin-top: 10rpx;
}

.empty-prompt {
  color: #888784;
  font-size: 23rpx;
}

.is-grid .empty-prompt {
  flex-direction: column;
  margin-top: 17rpx;
}

.plus {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border: 2rpx solid #dedbd7;
  border-radius: 50%;
  background: rgba(255, 255, 255, .78);
  color: #777;
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1;
}

.is-grid .plus {
  margin-bottom: 12rpx;
}

.is-mixed .meal-card {
  margin-bottom: 18rpx;
}

.is-mixed .meal-card.filled {
  overflow: hidden;
  border: 1rpx solid rgba(40, 33, 29, .04);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 12rpx 32rpx rgba(101, 75, 53, .08);
}

.record-row {
  display: flex;
  min-height: 190rpx;
  padding: 12rpx;
}

.meal-image {
  width: 222rpx;
  height: 190rpx;
  flex: none;
  border-radius: 22rpx;
  background: #f2ede7;
}

.record-copy {
  box-sizing: border-box;
  min-width: 0;
  flex: 1;
  padding: 8rpx 10rpx 4rpx 24rpx;
}

.record-heading {
  justify-content: space-between;
  min-height: 42rpx;
  margin-bottom: 7rpx;
}

.record-title {
  color: #171717;
  font-size: 31rpx;
  font-weight: 700;
}

.more-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  min-height: 52rpx;
  margin: -10rpx -10rpx 0 0;
  color: #676767;
  font-size: 26rpx;
  letter-spacing: 4rpx;
}

.status-line {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 6rpx;
  color: #858585;
  font-size: 21rpx;
  line-height: 1.35;
}

.status-line > text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 29rpx;
  height: 29rpx;
  margin-right: 11rpx;
  flex: none;
  border-radius: 50%;
  color: #fff;
  background: #88c993;
  font-size: 18rpx;
  font-weight: 700;
}

.status-processing .status-mark {
  color: #9b681e;
  background: #ffe3ad;
}

.status-failed {
  color: #b5574f;
}

.status-failed .status-mark {
  background: #eaa29b;
}

.mock-note {
  display: inline-block;
  margin-top: 6rpx;
  padding: 3rpx 10rpx;
  border-radius: 10rpx;
  color: #927253;
  background: #fbf0e4;
  font-size: 17rpx;
}

.is-mixed .meal-card.empty {
  min-height: 104rpx;
}

.is-mixed .empty-row {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 18rpx 34rpx;
}

.is-mixed .meal-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 24rpx;
  font-size: 48rpx;
}

.is-mixed .empty-copy {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.is-mixed .slot-name {
  width: 116rpx;
  flex: none;
}

.is-mixed .empty-prompt {
  min-width: 0;
  flex: 1;
}

.is-mixed .plus {
  width: 42rpx;
  height: 42rpx;
  margin-right: 16rpx;
  border: 0;
  background: transparent;
  font-size: 34rpx;
}

.tabbar {
  position: fixed;
  z-index: 20;
  left: 30rpx;
  right: 30rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  padding: 10rpx;
  border: 1rpx solid rgba(70, 58, 49, .05);
  border-radius: 38rpx;
  background: rgba(255, 255, 255, .95);
  box-shadow: 0 14rpx 46rpx rgba(69, 53, 42, .13);
  backdrop-filter: blur(18rpx);
}

.tab {
  box-sizing: border-box;
  min-height: 88rpx;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  border-radius: 29rpx;
  color: #7d7d7d;
  font-size: 23rpx;
}

.tab.active {
  color: #d94b43;
  background: #fde9e7;
  font-weight: 650;
}

.tab-icon {
  margin-bottom: 1rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.calendar-icon {
  font-size: 36rpx;
}

.tap-card,
.tap-target,
.tab {
  transition: opacity .15s ease, transform .15s ease, background-color .15s ease;
}

.tap-card-active {
  opacity: .76;
  transform: scale(.99);
}

.tap-soft,
.tab-pressed {
  opacity: .62;
  background: rgba(90, 78, 70, .07);
}

@media (max-width: 340px) {
  .page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .is-grid .meal-card.empty,
  .is-grid .empty-row {
    min-height: 256rpx;
  }

  .is-grid .meal-card.empty {
    width: calc(50% - 7rpx);
    margin-bottom: 14rpx;
  }

  .section-note {
    font-size: 19rpx;
  }

  .meal-image {
    width: 196rpx;
  }
}
