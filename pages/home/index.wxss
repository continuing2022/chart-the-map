.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 42rpx 34rpx 184rpx;
  padding-bottom: calc(184rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background:
    radial-gradient(circle at 92% 8%, rgba(255, 189, 126, .11), transparent 28%),
    linear-gradient(180deg, #fffcf8 0%, #fffaf4 100%);
}

.brand-row,
.day-overview,
.date-line,
.section-heading,
.record-heading,
.empty-prompt {
  display: flex;
  align-items: center;
}

.brand-row {
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 52rpx;
}

.brand-block {
  position: relative;
  padding-left: 4rpx;
}

.brand-title {
  position: relative;
  z-index: 1;
  color: #332722;
  font-family: "STKaiti", "KaiTi", "PingFang SC", sans-serif;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.04;
  letter-spacing: 2rpx;
}

.brand-rays {
  display: inline-block;
  margin-left: 8rpx;
  color: #ffa13d;
  font-size: 28rpx;
  vertical-align: top;
  transform: rotate(10deg);
}

.brand-underline {
  width: 258rpx;
  height: 18rpx;
  margin-top: -12rpx;
  border-radius: 50%;
  background: rgba(245, 126, 119, .28);
  transform: rotate(-2deg);
}

.brand-subtitle {
  margin-top: 8rpx;
  padding-left: 16rpx;
  color: #665b56;
  font-size: 22rpx;
  letter-spacing: 12rpx;
}

.settings {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-top: 2rpx;
  border-radius: 38rpx;
  color: #626364;
}

.settings-icon {
  font-size: 47rpx;
  line-height: 1;
}

.day-overview {
  justify-content: space-between;
  margin-bottom: 36rpx;
  padding: 0 8rpx;
}

.date-line {
  align-items: baseline;
}

.date-title {
  color: #151515;
  font-size: 43rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.weekday {
  margin-left: 25rpx;
  color: #797979;
  font-size: 27rpx;
  font-weight: 500;
}

.greeting {
  margin-top: 15rpx;
  color: #858585;
  font-size: 26rpx;
}

.greeting-sun {
  margin-right: 14rpx;
  color: #ffa13d;
  font-size: 30rpx;
}

.weather-art {
  padding-right: 10rpx;
  color: #ffa13d;
  font-size: 70rpx;
  font-weight: 300;
  line-height: 1;
}

.recap-card {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 98rpx;
  margin-bottom: 44rpx;
  padding: 24rpx 126rpx 24rpx 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(153, 195, 233, .18);
  border-radius: 30rpx;
  background: linear-gradient(105deg, #e5f2ff 0%, #dceeff 100%);
  color: #173b6b;
}

.recap-copy {
  min-width: 0;
  flex: 1;
}

.recap-title {
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.45;
}

.recap-body {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.recap-arrow {
  margin-left: 12rpx;
  font-size: 42rpx;
  font-weight: 300;
}

.recap-mascot {
  position: absolute;
  right: 15rpx;
  bottom: -4rpx;
  font-size: 66rpx;
  transform: rotate(-4deg);
}

.recap-mascot text {
  position: absolute;
  top: -12rpx;
  left: -10rpx;
  color: #cf8272;
  font-size: 23rpx;
}

.section-heading {
  justify-content: space-between;
  align-items: flex-end;
  margin: 0 6rpx 24rpx;
}

.section-title {
  color: #151515;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.section-note {
  color: #9a685a;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 21rpx;
  line-height: 1.45;
  text-align: right;
  transform: rotate(-4deg);
}

.section-note text {
  margin-left: 4rpx;
}

.slot-list.is-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.meal-card {
  box-sizing: border-box;
  min-width: 0;
}

.is-grid .meal-card.empty {
  width: calc(50% - 10rpx);
  min-height: 278rpx;
  margin-bottom: 20rpx;
}

.meal-card.empty {
  border: 2rpx dashed #d5d2ce;
  border-radius: 31rpx;
  background: rgba(255, 255, 255, .24);
}

.is-grid .empty-row {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  min-height: 274rpx;
  padding: 24rpx 18rpx;
  text-align: center;
}

.meal-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  flex: none;
}

.icon-sunrise,
.icon-lunch {
  color: #ffa13d;
}

.icon-dinner {
  color: #ff8064;
}

.icon-late-night {
  color: #8c8be6;
}

.sun-art {
  position: relative;
  width: 64rpx;
  height: 64rpx;
}

.sun-core {
  position: absolute;
  top: 15rpx;
  left: 15rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #ffb64f, #ff982b);
  box-shadow: 0 5rpx 12rpx rgba(255, 161, 61, .18);
}

.sun-ray {
  position: absolute;
  border-radius: 6rpx;
  background: currentColor;
}

.ray-one,
.ray-two {
  top: 30rpx;
  width: 10rpx;
  height: 4rpx;
}

.ray-one { left: 0; }
.ray-two { right: 0; }

.ray-three,
.ray-four {
  left: 30rpx;
  width: 4rpx;
  height: 10rpx;
}

.ray-three { top: 0; }
.ray-four { bottom: 0; }

.utensil-art {
  position: relative;
  width: 58rpx;
  height: 62rpx;
}

.fork-art {
  position: absolute;
  top: 7rpx;
  left: 8rpx;
  width: 18rpx;
  height: 51rpx;
  border-radius: 0 0 7rpx 7rpx;
  background: currentColor;
}

.fork-tines {
  position: absolute;
  top: 0;
  left: 4rpx;
  width: 3rpx;
  height: 19rpx;
  border-right: 3rpx solid #fffaf4;
  border-left: 3rpx solid #fffaf4;
}

.spoon-art {
  position: absolute;
  top: 4rpx;
  right: 6rpx;
  width: 20rpx;
  height: 27rpx;
  border-radius: 50%;
  background: currentColor;
}

.spoon-art::after {
  position: absolute;
  top: 21rpx;
  left: 7rpx;
  width: 7rpx;
  height: 34rpx;
  border-radius: 7rpx;
  background: currentColor;
  content: '';
}

.sunset-art {
  position: relative;
  width: 64rpx;
  height: 52rpx;
}

.sunset-core {
  position: absolute;
  top: 5rpx;
  left: 11rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #ff7d63 0%, #ffa43c 100%);
}

.sunset-line {
  position: absolute;
  z-index: 1;
  top: 30rpx;
  left: 0;
  width: 64rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: currentColor;
}

.moon-art {
  position: relative;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #aaa8f4, #7f7cdc);
  box-shadow: 0 6rpx 13rpx rgba(126, 124, 220, .18);
}

.moon-art::after {
  position: absolute;
  top: -5rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fffaf4;
  content: '';
}

.slot-name {
  color: #171717;
  font-size: 29rpx;
  font-weight: 700;
}

.is-grid .slot-name {
  margin-top: 10rpx;
}

.empty-prompt {
  color: #888784;
  font-size: 23rpx;
}

.is-grid .empty-prompt {
  flex-direction: column;
  margin-top: 17rpx;
}

.plus {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border: 2rpx solid #dedbd7;
  border-radius: 50%;
  background: rgba(255, 255, 255, .78);
  box-shadow: 0 5rpx 14rpx rgba(76, 67, 61, .05);
}

.plus-horizontal,
.plus-vertical {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 4rpx;
  background: #777;
  transform: translate(-50%, -50%);
}

.plus-horizontal {
  width: 23rpx;
  height: 4rpx;
}

.plus-vertical {
  width: 4rpx;
  height: 23rpx;
}

.is-grid .plus {
  margin-bottom: 12rpx;
}

.is-mixed .meal-card {
  margin-bottom: 18rpx;
}

.is-mixed .meal-card.filled {
  overflow: hidden;
  border: 1rpx solid rgba(40, 33, 29, .04);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 12rpx 32rpx rgba(101, 75, 53, .08);
}

.record-row {
  display: flex;
  min-height: 190rpx;
  padding: 12rpx;
}

.meal-image {
  width: 222rpx;
  height: 190rpx;
  flex: none;
  border-radius: 22rpx;
  background: #f2ede7;
}

.record-copy {
  box-sizing: border-box;
  min-width: 0;
  flex: 1;
  padding: 8rpx 10rpx 4rpx 24rpx;
}

.record-heading {
  justify-content: space-between;
  min-height: 42rpx;
  margin-bottom: 7rpx;
}

.record-title {
  color: #171717;
  font-size: 31rpx;
  font-weight: 700;
}

.more-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  min-height: 52rpx;
  margin: -10rpx -10rpx 0 0;
  color: #676767;
  font-size: 26rpx;
  letter-spacing: 4rpx;
}

.status-line {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 6rpx;
  color: #858585;
  font-size: 21rpx;
  line-height: 1.35;
}

.status-line > text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 29rpx;
  height: 29rpx;
  margin-right: 11rpx;
  flex: none;
  border-radius: 50%;
  color: #fff;
  background: #88c993;
  font-size: 18rpx;
  font-weight: 700;
}

.status-processing .status-mark {
  color: #9b681e;
  background: #ffe3ad;
}

.status-failed {
  color: #b5574f;
}

.status-failed .status-mark {
  background: #eaa29b;
}

.mock-note {
  display: inline-block;
  margin-top: 6rpx;
  padding: 3rpx 10rpx;
  border-radius: 10rpx;
  color: #927253;
  background: #fbf0e4;
  font-size: 17rpx;
}

.is-mixed .meal-card.empty {
  min-height: 104rpx;
}

.is-mixed .empty-row {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 18rpx 34rpx;
}

.is-mixed .meal-icon {
  width: 64rpx;
  height: 64rpx;
  margin: 0 24rpx 0 0;
}

.is-mixed .empty-copy {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.is-mixed .slot-name {
  width: 116rpx;
  flex: none;
}

.is-mixed .empty-prompt {
  min-width: 0;
  flex: 1;
}

.is-mixed .plus {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}

.tap-card,
.tap-target {
  transition: opacity .15s ease, transform .15s ease, background-color .15s ease;
}

.tap-card-active {
  opacity: .76;
  transform: scale(.99);
}

.tap-soft {
  opacity: .62;
  background: rgba(90, 78, 70, .07);
}

@media (max-width: 340px) {
  .page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .is-grid .meal-card.empty,
  .is-grid .empty-row {
    min-height: 256rpx;
  }

  .is-grid .meal-card.empty {
    width: calc(50% - 7rpx);
    margin-bottom: 14rpx;
  }

  .section-note {
    font-size: 19rpx;
  }

  .meal-image {
    width: 196rpx;
  }
}
