<app-nav status-bar-height="{{statusBarHeight}}" navigation-bar-height="{{navigationBarHeight}}" right-safe-width="{{navigationRightInset}}"></app-nav>
<view class="page safe-bottom" style="--navigation-total: {{navigationTotalHeight}}px;">
  <view class="day-journal">
    <view class="day-copy">
      <view class="date-line"><text class="date-title">{{dateTitle}}</text><text class="weekday">{{weekdayLabel}}</text></view>
      <view class="greeting">{{greeting}}</view>
    </view>
    <view class="journal-quote" aria-hidden="true">好好吃饭<br/>热爱生活 ♡</view>
  </view>
  <view wx:if="{{yesterdayRecap.recordedMeals}}" class="recap-card tap-card" hover-class="tap-card-active" bindtap="openYesterdayRecap" aria-role="button" aria-label="查看昨天的食光记录">
    <view class="recap-polaroid" aria-hidden="true">
      <image class="recap-photo" src="{{yesterdayRecap.records[0].stylizedImage || yesterdayRecap.records[0].imagePath}}" mode="aspectFill" />
    </view>
    <view class="recap-copy">
      <view class="recap-eyebrow">YESTERDAY</view>
      <view class="recap-title">昨天的食光已收藏</view>
      <view class="recap-body">记录了 {{yesterdayRecap.recordedMeals}} 餐，随时回看</view>
    </view>
    <image class="ui-icon recap-arrow" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true" />
  </view>
  <view class="section-heading">
    <view class="section-title">今天吃了什么</view>
    <view class="section-note">收藏生活的温柔</view>
  </view>
  <view class="slot-list is-grid {{hasRecords ? 'has-records' : ''}}">
    <view wx:for="{{slots}}" wx:for-item="slot" wx:key="key" class="meal-card meal-{{slot.key}} {{slot.record ? 'filled' : 'empty'}}">
      <view wx:if="{{slot.record}}" class="record-row tap-card" hover-class="tap-card-active" bindtap="openDetail" data-id="{{slot.record.id}}" aria-role="button" aria-label="查看{{slot.label}}详情">
        <view class="record-image-wrap"><image class="meal-image" src="{{slot.imageSource}}" mode="aspectFill" /></view>
        <view class="record-copy">
          <view class="record-heading">
            <view class="record-title">{{slot.label}}</view>
            <view class="more-button tap-target" hover-class="tap-soft" catchtap="showRecordActions" data-slot="{{slot}}" aria-role="button" aria-label="{{slot.label}}更多操作"><image class="ui-icon" src="/assets/icons/more.svg" mode="aspectFit" aria-hidden="true" /></view>
          </view>
          <view wx:for="{{slot.statusLines}}" wx:for-item="line" wx:key="text" class="status-line status-{{line.state}}">
            <text class="status-mark">{{line.state === 'complete' || line.state === 'saved' ? '✓' : (line.state === 'failed' ? '!' : '·')}}</text><text>{{line.text}}</text>
          </view>
          <view wx:if="{{slot.record.isMock}}" class="mock-note">本地模拟</view>
        </view>
      </view>
      <view wx:else class="empty-row tap-card" hover-class="tap-card-active" bindtap="chooseSource" data-slot="{{slot}}" aria-role="button" aria-label="点击记录{{slot.label}}">
        <view class="meal-art-shell" aria-hidden="true">
          <image wx:if="{{slot.key === 'breakfast'}}" class="meal-illustration" src="/assets/meal-breakfast.png" mode="aspectFit" />
          <image wx:elif="{{slot.key === 'lunch'}}" class="meal-illustration" src="/assets/meal-lunch.png" mode="aspectFit" />
          <image wx:elif="{{slot.key === 'dinner'}}" class="meal-illustration" src="/assets/meal-dinner.png" mode="aspectFit" />
          <image wx:else class="meal-illustration" src="/assets/meal-late-night.png" mode="aspectFit" />
        </view>
        <view class="empty-meta">
          <view class="slot-name">{{slot.label}}</view>
          <view class="empty-prompt"><text class="plus">＋</text><text>点击记录{{slot.label}}</text></view>
        </view>
      </view>
    </view>
  </view>
</view>
