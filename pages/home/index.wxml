<view class="page safe-bottom">
  <view class="topbar">
    <view>
      <view class="eyebrow">AI 饮食日记</view>
      <view class="title">食光日记</view>
      <view class="date">{{dateLabel}}</view>
    </view>
    <view class="settings" bindtap="openSettings">⚙</view>
  </view>

  <view wx:if="{{yesterdayInsight.recordedMeals}}" class="recap-card">
    <view class="recap-icon">✦</view>
    <view class="recap-copy">
      <view class="recap-title">昨天的食光已收藏</view>
      <view class="recap-body">记录了 {{yesterdayInsight.recordedMeals}} 餐，点进日历随时回看。</view>
    </view>
    <view class="recap-arrow" bindtap="openCalendar">›</view>
  </view>

  <view class="section-title">今天吃了什么</view>
  <view class="slot-list">
    <view wx:for="{{slots}}" wx:key="key" class="meal-card {{slot.record ? 'filled' : 'empty'}}">
      <view class="slot-heading">
        <view class="slot-name">{{slot.emoji}} {{slot.label}}</view>
        <view wx:if="{{slot.record && slot.record.stylizationTask.status === 'processing'}}" class="status">正在绘制</view>
        <view wx:elif="{{slot.record && slot.record.nutritionTask.status === 'processing'}}" class="status">正在分析</view>
        <view wx:elif="{{slot.record && (slot.record.stylizationTask.status === 'failed' || slot.record.nutritionTask.status === 'failed')}}" class="status error">需要重试</view>
      </view>
      <view wx:if="{{slot.record}}" class="record-row" bindtap="openDetail" data-id="{{slot.record.id}}">
        <image class="meal-image" src="{{slot.record.stylizedImage || slot.record.imagePath}}" mode="aspectFill" />
        <view class="record-copy">
          <view class="record-title">{{slot.record.stylizationTask.status === 'completed' ? slot.record.style + '风格回忆' : '照片已保存'}}</view>
          <view class="record-subtitle">{{slot.record.nutritionTask.status === 'completed' ? '营养估算已生成' : '你可以先离开，结果会自动回来'}}</view>
          <view wx:if="{{slot.record.isMock}}" class="mock-badge">本地模拟</view>
        </view>
        <view class="chevron">›</view>
      </view>
      <view wx:else class="empty-row" bindtap="chooseSource" data-slot="{{slot}}">
        <view class="plus">＋</view>
        <view>点击记录{{slot.label}}</view>
      </view>
    </view>
  </view>

  <view class="tabbar">
    <view class="tab active">今天</view>
    <view class="tab" bindtap="openCalendar">日历</view>
  </view>
</view>
