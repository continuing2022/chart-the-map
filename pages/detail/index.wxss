.page {
  box-sizing: border-box;
  background: var(--bg);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.navigation {
  position: relative;
  z-index: 5;
  background: var(--bg);
}

.nav-bar {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 44px;
  padding: 0 var(--gutter);
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 36px;
  flex: none;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background: var(--glass);
}

.nav-caption {
  margin-left: 20rpx;
  color: var(--muted);
  font-size: 28rpx;
}

.nav-balance {
  width: 100px;
  flex: none;
  margin-left: auto;
}

.content {
  box-sizing: border-box;
  padding: 24rpx var(--gutter) 0;
}

.meal-heading {
  margin-bottom: 24rpx;
}

.slot-title {
  font-size: var(--text-page);
  font-weight: 650;
  letter-spacing: -2rpx;
  line-height: 1.2;
}

.date-label {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: var(--text-caption);
}

.hero-wrap {
  position: relative;
  width: 100%;
  height: 34vh;
  min-height: 320rpx;
  max-height: 560rpx;
  overflow: hidden;
  border-radius: var(--radius-image);
  background: #f3ece3;
}

.hero-image {
  display: block;
  width: 100%;
  height: 100%;
}

.image-state {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  max-width: calc(100% - 32rpx);
  padding: 8rpx 14rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background: var(--glass);
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.4;
  backdrop-filter: blur(8px);
}

.state-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  flex: none;
  color: var(--brand);
}

.state-processing .state-mark {
  color: var(--accent);
}

.state-failed, .state-failed .state-mark {
  color: var(--danger);
}

.mini-spinner {
  display: block;
  box-sizing: border-box;
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  animation: spin .9s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }
.image-switch {
  display: flex;
  box-sizing: border-box;
  min-height: 44px;
  margin: 20rpx 0 32rpx;
  padding: 6rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-control);
  background: #efede8;
}

.image-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 38px;
  flex: 1;
  border-radius: 26rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.image-tab.selected {
  background: var(--surface);
  color: var(--brand);
  font-weight: 600;
  box-shadow: 0 3rpx 10rpx rgba(75, 58, 43, .06);
}

.image-tab.disabled {
  color: var(--quiet);
}

.tab-pressed {
  opacity: .65;
}

.status-banner {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: var(--radius-control);
}

.processing-banner {
  color: var(--muted);
  background: #f5eee1;
}

.error-banner {
  color: var(--danger);
  background: var(--brand-soft);
}

.banner-icon {
  margin-right: 16rpx;
  flex: none;
  font-size: 28rpx;
}

.banner-copy {
  min-width: 0;
  flex: 1;
}

.banner-title {
  font-size: 26rpx;
  font-weight: 600;
}

.banner-description {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.banner-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  margin-left: 8rpx;
  color: var(--brand);
  font-size: 26rpx;
}

.note-card {
  padding: 0 0 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
}

.edit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  margin-right: -12rpx;
}

.edit-glyph {
  width: 36rpx;
  height: 36rpx;
}

.note-copy {
  box-sizing: border-box;
  width: 100%;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: var(--text-body);
  line-height: 1.6;
  overflow-wrap: break-word;
  min-height: 44px;
}

.note-copy.placeholder {
  color: var(--quiet);
}

.note-editor-shell {
  box-sizing: border-box;
  width: 100%;
  margin-top: 8rpx;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(239, 98, 94, .25);
  border-radius: var(--radius-control);
  background: var(--surface);
}

/* Keep native textarea geometry free of borders/padding so its cursor and
   placeholder use the same origin on WeChat's native rendering layer. */
.note-editor {
  display: block;
  box-sizing: border-box;
  width: 100%;
  height: 44rpx;
  min-height: 44rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

/* Flow with the note, so the toolbar never leaves a large artificial gap. */
.bottom-actions {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  margin: 24rpx var(--gutter) 0;
  padding: 8rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-card);
  background: var(--glass);
  box-shadow: var(--float-shadow);
  backdrop-filter: blur(12px);
}

.action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 96rpx;
  flex: 1;
  flex-direction: column;
  color: var(--muted);
  border-radius: var(--radius-control);
}

.action-icon {
  display: block;
  width: 38rpx;
  height: 38rpx;
  margin-bottom: 8rpx;
}

.action-label {
  font-size: 24rpx;
  line-height: 1.3;
}

.action-divider {
  width: 1rpx;
  height: 44rpx;
  flex: none;
  background: var(--line);
}

.danger {
  color: var(--danger);
}

.action-pressed {
  opacity: .65;
}

@media (prefers-reduced-motion: reduce) { .mini-spinner { animation: none; } }
