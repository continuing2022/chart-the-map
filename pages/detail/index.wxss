.page {
  box-sizing: border-box;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 88% 3%, rgba(255, 200, 150, .12), transparent 27%),
    linear-gradient(180deg, #fffcf8 0%, #fffaf4 100%);
}

.navigation {
  position: relative;
  z-index: 5;
  box-sizing: border-box;
  background: rgba(255, 252, 248, .94);
}

.nav-bar,
.card-heading,
.nutrition-title-group,
.food-row,
.food-info,
.portion-group,
.status-banner,
.candidate-actions,
.bottom-actions,
.action-button {
  display: flex;
  align-items: center;
}

.nav-bar {
  box-sizing: border-box;
  min-height: 112rpx;
  padding: 10rpx 30rpx 12rpx;
  justify-content: space-between;
}

.back-button,
.nav-balance {
  width: 70rpx;
  height: 70rpx;
  flex: none;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(70, 57, 48, .05);
  border-radius: 50%;
  background: rgba(255, 255, 255, .96);
  box-shadow: 0 8rpx 26rpx rgba(78, 58, 44, .09);
}

.back-chevron {
  width: 18rpx;
  height: 18rpx;
  margin-left: 7rpx;
  border-bottom: 5rpx solid #17202c;
  border-left: 5rpx solid #17202c;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.nav-copy {
  min-width: 0;
  flex: 1;
  padding: 0 18rpx;
  text-align: center;
}

.slot-title {
  color: #121b29;
  font-size: 35rpx;
  font-weight: 750;
  line-height: 1.3;
  letter-spacing: 2rpx;
}

.date-label {
  margin-top: 3rpx;
  color: #8d9098;
  font-size: 24rpx;
  line-height: 1.35;
}

.content {
  box-sizing: border-box;
  padding: 10rpx 28rpx 258rpx;
  padding-bottom: calc(258rpx + env(safe-area-inset-bottom));
}

.hero-wrap {
  position: relative;
  width: 100%;
  height: 510rpx;
  overflow: hidden;
  border-radius: 31rpx;
  background: linear-gradient(145deg, #faeee3, #f6dfd1);
  box-shadow: 0 17rpx 42rpx rgba(99, 64, 39, .12);
}

.hero-image {
  display: block;
  width: 100%;
  height: 100%;
}

.image-state {
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  display: flex;
  align-items: center;
  max-width: calc(100% - 40rpx);
  box-sizing: border-box;
  min-height: 54rpx;
  padding: 9rpx 19rpx 9rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, .55);
  border-radius: 27rpx;
  background: rgba(255, 250, 245, .91);
  box-shadow: 0 7rpx 20rpx rgba(72, 48, 35, .11);
  color: #4d3c33;
  font-size: 22rpx;
  line-height: 1.35;
  backdrop-filter: blur(16rpx);
}

.state-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  margin-right: 9rpx;
  flex: none;
  border-radius: 50%;
  color: #e75f59;
  font-size: 22rpx;
  font-weight: 750;
}

.state-processing .state-mark {
  color: #c98235;
}

.state-failed {
  color: #a44943;
  background: rgba(255, 244, 241, .94);
}

.mini-spinner,
.notice-spinner {
  display: block;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  animation: spin .9s linear infinite;
}

.mini-spinner {
  width: 24rpx;
  height: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.image-switch {
  display: flex;
  min-height: 90rpx;
  margin: 20rpx 0 25rpx;
  padding: 5rpx;
  border: 1rpx solid rgba(89, 70, 57, .035);
  border-radius: 45rpx;
  background: #f1f1f2;
  box-shadow: inset 0 2rpx 4rpx rgba(74, 65, 59, .025);
}

.image-tab {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 80rpx;
  flex: 1;
  border: 2rpx solid transparent;
  border-radius: 40rpx;
  color: #8b8c91;
  font-size: 27rpx;
  font-weight: 550;
  transition: background-color .15s ease, color .15s ease, opacity .15s ease, transform .15s ease;
}

.image-tab.selected {
  border-color: rgba(239, 107, 101, .18);
  background: rgba(255, 255, 255, .98);
  box-shadow: 0 7rpx 18rpx rgba(88, 68, 55, .08);
  color: #e8534e;
  font-weight: 650;
}

.image-tab.disabled {
  color: #bbb9b7;
}

.tab-pressed {
  opacity: .7;
  transform: scale(.985);
}

.status-banner {
  box-sizing: border-box;
  min-height: 100rpx;
  margin-bottom: 23rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
}

.processing-banner {
  background: #fff5e8;
  color: #875a28;
}

.error-banner {
  background: #fff0ed;
  color: #9c4843;
}

.banner-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  margin-right: 15rpx;
  flex: none;
  border-radius: 50%;
  background: rgba(255, 255, 255, .7);
  font-size: 24rpx;
  font-weight: 750;
}

.banner-copy {
  min-width: 0;
  flex: 1;
}

.banner-title {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.banner-description {
  margin-top: 2rpx;
  color: rgba(91, 72, 59, .7);
  font-size: 20rpx;
  line-height: 1.45;
}

.banner-action {
  min-width: 70rpx;
  margin-left: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .75);
  color: #d8504a;
  font-size: 23rpx;
  font-weight: 650;
  text-align: center;
}

.card {
  box-sizing: border-box;
  margin-bottom: 23rpx;
  border: 1rpx solid rgba(80, 62, 48, .035);
  border-radius: 31rpx;
  background: rgba(255, 255, 255, .95);
  box-shadow: 0 13rpx 38rpx rgba(89, 65, 47, .075);
}

.note-card {
  min-height: 174rpx;
  padding: 27rpx 29rpx 28rpx;
}

.card-heading {
  justify-content: space-between;
}

.card-title {
  color: #131c29;
  font-size: 34rpx;
  font-weight: 750;
  line-height: 1.35;
  letter-spacing: -1rpx;
}

.edit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin: -7rpx -8rpx -7rpx 10rpx;
  border-radius: 28rpx;
}

.edit-glyph {
  position: relative;
  width: 31rpx;
  height: 31rpx;
  box-sizing: border-box;
  border: 4rpx solid #8b929c;
  border-top-color: transparent;
  border-radius: 6rpx;
}

.edit-glyph::before {
  position: absolute;
  top: -7rpx;
  right: -5rpx;
  width: 8rpx;
  height: 27rpx;
  border: 3rpx solid #8b929c;
  border-radius: 5rpx;
  background: #fff;
  content: '';
  transform: rotate(42deg);
  transform-origin: center;
}

.note-copy,
.note-editor {
  box-sizing: border-box;
  width: 100%;
  min-height: 58rpx;
  margin-top: 9rpx;
  color: #757982;
  font-size: 27rpx;
  line-height: 1.6;
}

.note-copy.placeholder {
  color: #aaa8a5;
}

.note-editor {
  min-height: 76rpx;
  padding: 9rpx 13rpx;
  border: 2rpx solid rgba(234, 105, 99, .2);
  border-radius: 16rpx;
  background: #fffaf9;
  color: #4c5057;
}

.nutrition-card {
  padding: 29rpx 28rpx 28rpx;
}

.nutrition-heading {
  min-height: 57rpx;
  margin-bottom: 14rpx;
}

.nutrition-title-group {
  min-width: 0;
  flex: 1;
}

.confirmed-badge {
  margin-left: 16rpx;
  padding: 7rpx 13rpx;
  border-radius: 19rpx;
  background: #eef8ef;
  color: #559461;
  font-size: 19rpx;
  font-weight: 600;
  white-space: nowrap;
}

.confirmed-badge text {
  margin-right: 3rpx;
}

.help-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: -3rpx;
  flex: none;
  border: 4rpx solid #9299a4;
  border-radius: 50%;
  color: #858c97;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1;
}

.food-list {
  padding: 3rpx 0 14rpx;
}

.food-row {
  min-height: 93rpx;
  justify-content: space-between;
}

.food-info {
  min-width: 0;
  flex: 1;
  padding-right: 12rpx;
}

.food-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  margin-right: 15rpx;
  flex: none;
  border-radius: 20rpx;
  background: #fff1e7;
  font-size: 39rpx;
  line-height: 1;
}

.food-icon-vegetable { background: #eef8e9; }
.food-icon-protein { background: #fff2e7; }
.food-icon-fruit { background: #fff0ef; }
.food-icon-grain { background: #fff5e7; }

.food-name {
  min-width: 0;
  overflow: hidden;
  color: #333842;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.portion-group {
  box-sizing: border-box;
  min-width: 284rpx;
  padding: 4rpx;
  flex: none;
  justify-content: space-between;
  border-radius: 30rpx;
  background: #f4f4f5;
}

.portion {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 86rpx;
  height: 52rpx;
  padding: 0 12rpx;
  border: 2rpx solid transparent;
  border-radius: 26rpx;
  color: #81858d;
  font-size: 21rpx;
  font-weight: 550;
  transition: opacity .15s ease, transform .15s ease;
}

.portion.selected {
  border-color: rgba(238, 105, 100, .33);
  background: #fff;
  box-shadow: 0 4rpx 11rpx rgba(101, 71, 57, .07);
  color: #ea5a54;
  font-weight: 700;
}

.portion-pressed {
  opacity: .62;
  transform: scale(.97);
}

.nutrition-summary {
  box-sizing: border-box;
  margin-top: 9rpx;
  padding: 22rpx 24rpx 24rpx;
  border-radius: 23rpx;
  background: linear-gradient(108deg, #fff4f0 0%, #fff0ed 100%);
}

.calorie-line {
  display: flex;
  align-items: baseline;
  color: #ed554f;
}

.approximately {
  margin-right: 8rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.calorie-value {
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 1rpx;
}

.calorie-unit {
  margin-left: 9rpx;
  font-size: 31rpx;
  font-weight: 700;
}

.macro-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 14rpx;
  color: #818184;
  font-size: 23rpx;
  line-height: 1.6;
}

.macro-dot {
  margin: 0 12rpx;
  color: #aaa8a6;
}

.analysis-notice {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 15rpx 17rpx;
  border-radius: 18rpx;
  background: #fff7e9;
  color: #856237;
  font-size: 21rpx;
  line-height: 1.5;
}

.notice-spinner {
  width: 23rpx;
  height: 23rpx;
  margin-right: 11rpx;
  flex: none;
}

.analysis-failed {
  background: #fff0ed;
  color: #9d4a45;
}

.notice-symbol {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26rpx;
  height: 26rpx;
  margin-right: 9rpx;
  flex: none;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  font-size: 18rpx;
  font-weight: 700;
}

.notice-link {
  margin-left: auto;
  padding: 4rpx 7rpx;
  color: #df4f49;
  font-weight: 700;
}

.candidate-card {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 2rpx solid #f1d6bc;
  border-radius: 22rpx;
  background: #fffaf3;
}

.candidate-label {
  color: #744e2f;
  font-size: 24rpx;
  font-weight: 700;
}

.candidate-copy {
  margin-top: 3rpx;
  color: #8e7d70;
  font-size: 20rpx;
}

.candidate-result {
  display: flex;
  flex-direction: column;
  margin-top: 15rpx;
  padding: 14rpx 16rpx;
  border-radius: 15rpx;
  background: rgba(255, 255, 255, .76);
  color: #77716c;
  font-size: 20rpx;
  line-height: 1.55;
}

.candidate-result text:first-child {
  color: #df5b54;
  font-size: 25rpx;
  font-weight: 700;
}

.candidate-actions {
  margin-top: 15rpx;
  justify-content: flex-end;
}

.candidate-button {
  padding: 12rpx 19rpx;
  border-radius: 24rpx;
  font-size: 21rpx;
  font-weight: 650;
}

.candidate-button.primary {
  background: #ef7770;
  color: #fff;
}

.candidate-button.secondary {
  margin-left: 11rpx;
  background: #f0ece7;
  color: #77716c;
}

.candidate-pressed {
  opacity: .68;
  transform: scale(.98);
}

.disclaimer {
  margin-top: 21rpx;
  padding: 0 4rpx;
  color: #98989c;
  font-size: 21rpx;
  line-height: 1.55;
}

.nutrition-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 34rpx 10rpx 29rpx;
  text-align: center;
}

.loading-orbit,
.failed-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 17rpx;
  border-radius: 50%;
  background: #fff2e3;
  color: #d98a3d;
}

.loading-orbit text {
  display: block;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  animation: spin .9s linear infinite;
}

.failed-mark {
  background: #fff0ed;
  color: #d9554e;
  font-size: 28rpx;
  font-weight: 750;
}

.empty-title {
  color: #555a62;
  font-size: 25rpx;
  font-weight: 650;
}

.empty-description {
  margin-top: 6rpx;
  color: #9a9896;
  font-size: 21rpx;
  line-height: 1.5;
}

.inline-retry {
  margin-top: 16rpx;
  padding: 12rpx 26rpx;
  border-radius: 24rpx;
  background: #fff0ed;
  color: #df544d;
  font-size: 22rpx;
  font-weight: 650;
}

.bottom-actions {
  position: fixed;
  z-index: 20;
  right: 25rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  left: 25rpx;
  box-sizing: border-box;
  min-height: 129rpx;
  padding: 9rpx 7rpx;
  justify-content: space-between;
  border: 1rpx solid rgba(70, 58, 49, .055);
  border-radius: 35rpx;
  background: rgba(255, 255, 255, .96);
  box-shadow: 0 17rpx 50rpx rgba(69, 53, 42, .15);
  backdrop-filter: blur(20rpx);
}

.action-button {
  min-width: 0;
  min-height: 108rpx;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  border-radius: 27rpx;
  color: #17202c;
  transition: opacity .15s ease, transform .15s ease, background-color .15s ease;
}

.action-divider {
  width: 1rpx;
  height: 72rpx;
  flex: none;
  background: #ecebea;
}

.action-icon {
  position: relative;
  width: 47rpx;
  height: 45rpx;
  margin-bottom: 5rpx;
}

.action-label {
  overflow: hidden;
  font-size: 18rpx;
  font-weight: 550;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.camera-icon {
  box-sizing: border-box;
  height: 36rpx;
  margin-top: 5rpx;
  margin-bottom: 9rpx;
  border: 5rpx solid currentColor;
  border-radius: 8rpx;
}

.camera-icon::before {
  position: absolute;
  top: -12rpx;
  left: 8rpx;
  width: 20rpx;
  height: 11rpx;
  border: 5rpx solid currentColor;
  border-bottom: 0;
  border-radius: 6rpx 6rpx 0 0;
  content: '';
}

.camera-icon text {
  display: block;
  width: 13rpx;
  height: 13rpx;
  margin: 7rpx auto 0;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.refresh-icon {
  font-size: 55rpx;
  font-weight: 400;
  line-height: 42rpx;
  text-align: center;
}

.analysis-icon {
  box-sizing: border-box;
  width: 45rpx;
  height: 40rpx;
  margin-top: 2rpx;
  margin-bottom: 8rpx;
  border: 5rpx solid currentColor;
  border-radius: 50%;
}

.analysis-icon::after {
  position: absolute;
  right: 1rpx;
  bottom: -7rpx;
  width: 13rpx;
  height: 11rpx;
  border-bottom: 5rpx solid currentColor;
  transform: rotate(-25deg);
  content: '';
}

.analysis-icon text {
  display: block;
  width: 18rpx;
  height: 4rpx;
  margin: 16rpx auto 0;
  border-radius: 2rpx;
  background: currentColor;
}

.danger {
  color: #ed302d;
}

.trash-icon {
  box-sizing: border-box;
  width: 34rpx;
  height: 39rpx;
  margin-top: 2rpx;
  margin-bottom: 9rpx;
  border: 5rpx solid currentColor;
  border-top: 0;
  border-radius: 2rpx 2rpx 7rpx 7rpx;
}

.trash-icon::before {
  position: absolute;
  top: -9rpx;
  left: -8rpx;
  width: 40rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: currentColor;
  content: '';
}

.trash-icon::after {
  position: absolute;
  top: -16rpx;
  left: 8rpx;
  width: 10rpx;
  height: 7rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 4rpx 4rpx 0 0;
  content: '';
}

.trash-icon text {
  display: block;
  width: 4rpx;
  height: 22rpx;
  margin: 7rpx auto 0;
  border-radius: 2rpx;
  background: currentColor;
  box-shadow: -9rpx 0 0 currentColor, 9rpx 0 0 currentColor;
}

.action-pressed,
.tap-soft {
  opacity: .64;
  background: rgba(90, 78, 70, .07);
  transform: scale(.985);
}

.tap-target {
  transition: opacity .15s ease, transform .15s ease, background-color .15s ease;
}

@media (max-width: 340px) {
  .content {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .hero-wrap { height: 485rpx; }
  .nutrition-card { padding-right: 21rpx; padding-left: 21rpx; }
  .food-icon { width: 54rpx; height: 54rpx; margin-right: 10rpx; font-size: 33rpx; }
  .food-name { font-size: 23rpx; }
  .portion-group { min-width: 276rpx; }
  .portion { min-width: 83rpx; padding-right: 8rpx; padding-left: 8rpx; }
  .confirmed-badge { margin-left: 10rpx; padding-right: 10rpx; padding-left: 10rpx; font-size: 18rpx; }
  .macro-dot { margin-right: 8rpx; margin-left: 8rpx; }
  .bottom-actions { right: 18rpx; left: 18rpx; }
  .action-label { font-size: 17rpx; }
}
