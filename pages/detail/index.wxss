.page { padding: 30rpx 32rpx 70rpx; }.nav { display: flex; align-items: center; margin-bottom: 30rpx; }.back { margin-right: 14rpx; width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; background: #fff; border-radius: 28rpx; font-size: 48rpx; line-height: 1; }.slot { font-size: 34rpx; font-weight: 700; }.date { margin-top: 2rpx; font-size: 23rpx; color: #8e8e93; }.hero-image { width: 100%; height: 580rpx; border-radius: 34rpx; background: #eee; }.image-actions,.card-head { display: flex; justify-content: space-between; align-items: center; }.image-actions { margin: 18rpx 2rpx 30rpx; }.ai-label,.confirmed { padding: 7rpx 14rpx; border-radius: 16rpx; background: #f0edff; color: #7563af; font-size: 21rpx; }.link { color: #5272cc; font-size: 24rpx; }.notice { margin-bottom: 22rpx; padding: 20rpx; background: #fff7e8; color: #8a6112; border-radius: 20rpx; font-size: 23rpx; }.card { margin-bottom: 20rpx; padding: 28rpx; background: #fff; border-radius: 28rpx; }.card-title { font-size: 29rpx; font-weight: 700; }.note { margin-top: 16rpx; width: 100%; color: #4d4d52; font-size: 27rpx; line-height: 1.55; }.muted { margin-top: 20rpx; color: #8e8e93; font-size: 25rpx; }.food-row { display: flex; justify-content: space-between; align-items: center; padding-top: 24rpx; }.food-name { font-size: 27rpx; }.portion-group { display: flex; padding: 4rpx; border-radius: 16rpx; background: #f3f3f6; }.portion { padding: 8rpx 14rpx; border-radius: 12rpx; color: #77777e; font-size: 21rpx; }.portion.selected { background: #fff; color: #1d1d1f; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.08); }.nutrition-line { margin-top: 32rpx; font-size: 38rpx; font-weight: 700; }.macro-line { margin-top: 10rpx; color: #606066; font-size: 24rpx; }.disclaimer { margin-top: 16rpx; color: #9d9da3; font-size: 20rpx; line-height: 1.5; }.action-row { display: flex; gap: 18rpx; }.secondary { flex: 1; padding: 20rpx 8rpx; border-radius: 22rpx; background: #fff; color: #4f6fc5; font-size: 23rpx; }.delete { margin-top: 20rpx; background: transparent; color: #d83b35; font-size: 25rpx; }
