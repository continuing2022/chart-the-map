<view wx:if="{{record}}" class="page safe-bottom">
  <view class="nav" bindtap="navigateBack"> <view class="back" bindtap="navigateBack">‹</view><view><view class="slot">{{record.slotKey === 'breakfast' ? '早餐' : record.slotKey === 'lunch' ? '午餐' : record.slotKey === 'dinner' ? '晚餐' : '夜宵'}}</view><view class="date">{{dateLabel}}</view></view></view>
  <image class="hero-image" src="{{showOriginal || record.stylizationTask.status !== 'completed' ? record.imagePath : record.stylizedImage}}" mode="aspectFill" />
  <view class="image-actions"><view class="ai-label">{{record.stylizationTask.status === 'completed' && !showOriginal ? 'AI ' + record.style + '风格 · 本地模拟' : '原始照片'}}</view><view wx:if="{{record.stylizationTask.status === 'completed'}}" class="link" bindtap="toggleImage">{{showOriginal ? '查看风格图' : '查看原始照片'}}</view></view>
  <view wx:if="{{record.stylizationTask.status === 'processing'}}" class="notice">正在绘制可爱版本，你可以先继续记录其他餐次。</view>
  <view wx:elif="{{record.stylizationTask.status === 'failed'}}" class="notice error">{{record.stylizationTask.error}}</view>
  <view class="card"><view class="card-title">这一餐的小记</view><textarea class="note" maxlength="50" placeholder="写下一句关于这餐的记忆…" value="{{record.note}}" bindblur="saveNote" auto-height /></view>
  <view class="card"><view class="card-head"><view class="card-title">营养估算</view><view wx:if="{{record.manuallyConfirmed}}" class="confirmed">已人工确认</view></view><view wx:if="{{record.nutritionTask.status === 'processing' && !record.nutrition}}" class="muted">正在分析菜品与份量…</view><block wx:if="{{record.nutrition}}"><view wx:for="{{record.nutrition.items}}" wx:for-index="foodIndex" wx:key="name" class="food-row"><view class="food-name">{{item.name}}</view><view class="portion-group"><view wx:for="{{portions}}" wx:for-index="portionIndex" wx:key="*this" data-item-index="{{foodIndex}}" data-portion="{{item}}" bindtap="changePortion" class="portion {{record.nutrition.items[foodIndex].portion === item ? 'selected' : ''}}">{{item}}</view></view></view><view class="nutrition-line">约 {{record.nutrition.calories}} kcal</view><view class="macro-line">蛋白质 {{record.nutrition.protein}}g · 脂肪 {{record.nutrition.fat}}g · 碳水 {{record.nutrition.carbs}}g</view><view class="disclaimer">基于图片与份量的本地模拟估算，仅供饮食记录参考。</view></block><view wx:elif="{{record.nutritionTask.status === 'failed'}}" class="muted">{{record.nutritionTask.error}}</view><view wx:if="{{record.nutritionTask.status === 'processing' && record.nutrition}}" class="candidate-note">正在重新分析，当前人工确认结果会保留。</view><view wx:if="{{record.nutritionCandidate}}" class="candidate-note"><view>新的分析已完成，当前人工确认结果未被覆盖。</view><view class="candidate-actions"><view class="candidate-link" bindtap="acceptNutritionCandidate">采用新分析</view><view class="candidate-link muted-link" bindtap="dismissNutritionCandidate">保留当前结果</view></view></view></view>
  <view class="action-row"><button class="secondary" bindtap="chooseReplacement">替换照片</button><button class="secondary" bindtap="retryStylization">重新生成风格图</button></view><button class="secondary full" bindtap="retryNutrition">重新分析营养</button><button class="delete" bindtap="deleteRecord">删除这餐</button>
</view>
