<view wx:if="{{record}}" class="page">
  <view class="navigation" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="back-button tap-target" bindtap="navigateBack" hover-class="tap-soft" aria-role="button" aria-label="返回上一页">
        <image class="ui-icon" src="/assets/icons/back.svg" mode="aspectFit" aria-hidden="true" />
      </view>
      <view class="nav-caption">餐食详情</view>
      <view class="nav-balance" aria-hidden="true"></view>
    </view>
  </view>

  <view class="content">
    <view class="meal-heading"><view class="slot-title">{{slotLabel}}</view><view class="date-label">{{dateLabel}}</view></view>
    <view class="hero-wrap">
      <image class="hero-image" src="{{showOriginal || record.stylizationTask.status !== 'completed' ? record.imagePath : record.stylizedImage}}" mode="aspectFill" />
      <view class="image-state state-{{record.stylizationTask.status}}">
        <view class="state-mark" aria-hidden="true">
          <text wx:if="{{record.stylizationTask.status === 'processing'}}" class="mini-spinner"></text>
          <text wx:elif="{{record.stylizationTask.status === 'failed'}}">!</text>
          <text wx:else>◇</text>
        </view>
        <text wx:if="{{record.stylizationTask.status === 'processing'}}">风格图生成中 · 当前为原始照片</text>
        <text wx:elif="{{record.stylizationTask.status === 'failed'}}">生成失败 · 当前为原始照片</text>
        <text wx:elif="{{showOriginal}}">原始照片</text>
        <text wx:else>AI {{record.style}}风格{{record.isMock ? ' · 本地模拟' : ''}}</text>
      </view>
    </view>

    <view class="image-switch" aria-role="tablist" aria-label="切换餐食图片">
      <view class="image-tab {{!showOriginal ? 'selected' : ''}} {{record.stylizationTask.status !== 'completed' ? 'disabled' : ''}}" bindtap="showStylizedImage" hover-class="{{record.stylizationTask.status === 'completed' ? 'tab-pressed' : ''}}" aria-role="tab" aria-selected="{{!showOriginal}}" aria-disabled="{{record.stylizationTask.status !== 'completed'}}">
        {{record.style}}风格图
      </view>
      <view class="image-tab {{showOriginal ? 'selected' : ''}}" bindtap="showOriginalImage" hover-class="tab-pressed" aria-role="tab" aria-selected="{{showOriginal}}">
        原始照片
      </view>
    </view>

    <view wx:if="{{record.stylizationTask.status === 'processing'}}" class="status-banner processing-banner">
      <view class="banner-icon" aria-hidden="true">✦</view>
      <view class="banner-copy">
        <view class="banner-title">正在绘制这餐的风格回忆</view>
        <view class="banner-description">完成前会保留原始照片，你可以继续浏览和编辑。</view>
      </view>
    </view>
    <view wx:elif="{{record.stylizationTask.status === 'failed'}}" class="status-banner error-banner">
      <view class="banner-icon" aria-hidden="true">!</view>
      <view class="banner-copy">
        <view class="banner-title">风格图暂时没有生成</view>
        <view class="banner-description">{{record.stylizationTask.error || '处理失败，请稍后重试。'}}</view>
      </view>
      <view class="banner-action" bindtap="retryStylization" hover-class="tap-soft" aria-role="button">重试</view>
    </view>

    <view class="card note-card">
      <view class="card-heading">
        <view class="card-title">这一餐的小记</view>
        <view class="edit-button tap-target" bindtap="startNoteEdit" hover-class="tap-soft" aria-role="button" aria-label="编辑这一餐的小记">
          <image class="edit-glyph" src="/assets/icons/edit-note.svg" mode="aspectFit" aria-hidden="true" />
        </view>
      </view>
      <view wx:if="{{!noteEditing}}" class="note-copy {{record.note ? '' : 'placeholder'}}" bindtap="startNoteEdit">
        {{record.note || '写下一句关于这餐的记忆…'}}
      </view>
      <view wx:else class="note-editor-shell">
        <textarea class="note-editor" maxlength="50" placeholder="写下一句关于这餐的记忆…" placeholder-style="color: #AAA5A0; font-size: 28rpx; line-height: 44rpx;" value="{{record.note}}" focus="{{noteEditing}}" bindblur="saveNote" auto-height show-confirm-bar="false" aria-label="餐食小记，最多50字" />
      </view>
    </view>

  </view>

  <view class="bottom-actions">
    <view class="action-button" bindtap="confirmReplacement" hover-class="action-pressed" aria-role="button" aria-label="替换照片">
      <image class="action-icon" src="/assets/icons/camera.svg" mode="aspectFit" aria-hidden="true" />
      <view class="action-label">替换照片</view>
    </view>
    <view class="action-divider"></view>
    <view class="action-button" bindtap="retryStylization" hover-class="action-pressed" aria-role="button" aria-label="重新生成风格图">
      <image class="action-icon" src="/assets/icons/refresh.svg" mode="aspectFit" aria-hidden="true" />
      <view class="action-label">重做风格图</view>
    </view>
    <view class="action-divider"></view>
    <view class="action-button danger" bindtap="deleteRecord" hover-class="action-pressed" aria-role="button" aria-label="删除这餐">
      <image class="action-icon" src="/assets/icons/delete.svg" mode="aspectFit" aria-hidden="true" />
      <view class="action-label">删除这餐</view>
    </view>
  </view>
</view>
