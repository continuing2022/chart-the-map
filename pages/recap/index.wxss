.page {
  box-sizing: border-box;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 88% 9%, rgba(255, 192, 129, .10), transparent 27%),
    linear-gradient(180deg, #fffdf9 0%, #fff9f2 100%);
  color: #17191d;
}

.topbar { position: relative; z-index: 5; }

.nav-row,
.nav-action,
.nav-date,
.summary-primary,
.primary-metric,
.macro-list,
.macro-item,
.guidance-card {
  display: flex;
  align-items: center;
}

.nav-row {
  box-sizing: border-box;
  min-height: 116rpx;
  padding: 8rpx 26rpx 10rpx;
  justify-content: space-between;
}

.nav-action,
.nav-spacer {
  width: 80rpx;
  height: 80rpx;
  flex: none;
}

.nav-action { justify-content: center; border-radius: 40rpx; }

.close-icon { position: relative; width: 40rpx; height: 40rpx; }

.close-icon::before,
.close-icon::after {
  position: absolute;
  top: 18rpx;
  left: 1rpx;
  width: 39rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #26303e;
  content: '';
}

.close-icon::before { transform: rotate(45deg); }
.close-icon::after { transform: rotate(-45deg); }

.nav-copy { min-width: 0; flex: 1; text-align: center; }

.nav-title {
  font-size: 39rpx;
  font-weight: 750;
  line-height: 1.25;
  letter-spacing: 2rpx;
}

.nav-date {
  justify-content: center;
  margin-top: 6rpx;
  color: #767b83;
  font-size: 23rpx;
  line-height: 1.4;
}

.nav-date text + text { margin-left: 23rpx; }

.content {
  box-sizing: border-box;
  padding: 21rpx 34rpx 54rpx;
  padding-bottom: calc(54rpx + env(safe-area-inset-bottom));
}

.memory-heading {
  position: relative;
  box-sizing: border-box;
  min-height: 151rpx;
  padding: 15rpx 29rpx 4rpx;
  color: #9d473a;
  font-family: "STKaiti", "KaiTi", "PingFang SC", serif;
  font-size: 39rpx;
  line-height: 1.6;
  letter-spacing: 5rpx;
  transform: rotate(-1.5deg);
}

.heading-line-two { padding-left: 89rpx; white-space: nowrap; }

.heading-ray {
  display: inline-block;
  margin-left: 13rpx;
  color: #f2a94b;
  font-family: sans-serif;
  font-size: 34rpx;
  transform: rotate(18deg);
}

.heading-heart {
  display: inline-block;
  margin-left: 11rpx;
  color: #8c3e34;
  font-size: 50rpx;
  line-height: .7;
  transform: rotate(8deg);
}

.heading-stroke {
  position: absolute;
  left: 33rpx;
  bottom: 25rpx;
  width: 62rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #f4b35f;
  transform: rotate(-23deg);
}

.photo-collage {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-template-rows: repeat(2, 222rpx);
  gap: 10rpx;
  min-height: 454rpx;
  margin-top: 7rpx;
}

.recap-photo {
  width: 100%;
  height: 100%;
  border-radius: 27rpx;
  background: #f1e9e0;
  transition: opacity .15s ease, transform .15s ease;
}

.photo-pressed { opacity: .78; transform: scale(.985); }

.memory-note {
  position: relative;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding: 29rpx 24rpx 19rpx;
  border-radius: 9rpx 18rpx 13rpx 11rpx;
  background: linear-gradient(145deg, #fffdf5, #fff7e7);
  box-shadow: 0 10rpx 27rpx rgba(113, 83, 57, .10);
  color: #684235;
  font-family: "STKaiti", "KaiTi", "PingFang SC", serif;
  font-size: 32rpx;
  line-height: 1.55;
  letter-spacing: 4rpx;
  text-align: center;
  transform: rotate(-4deg) scale(.91);
}

.note-tape {
  position: absolute;
  top: -10rpx;
  left: 50%;
  width: 74rpx;
  height: 23rpx;
  background: rgba(241, 217, 177, .52);
  transform: translateX(-50%) rotate(2deg);
}

.collage-1 .recap-photo { grid-column: 1 / -1; grid-row: 1 / -1; }

.collage-1 .memory-note {
  z-index: 2;
  grid-column: 2;
  grid-row: 2;
  align-self: end;
  min-height: 170rpx;
  margin: 12rpx;
  background: rgba(255, 250, 237, .94);
}

.collage-2 .recap-photo { grid-row: 1 / -1; }
.collage-2 .memory-note { display: none; }
.collage-3 .photo-3 { grid-column: 1; grid-row: 2; }
.collage-3 .memory-note { grid-column: 2; grid-row: 2; }
.collage-4 .photo-1 { grid-column: 1; grid-row: 1; }
.collage-4 .photo-2 { grid-column: 2; grid-row: 1; }
.collage-4 .photo-3 { grid-column: 1; grid-row: 2; }
.collage-4 .photo-4 { grid-column: 2; grid-row: 2; }

.summary-card,
.guidance-card {
  box-sizing: border-box;
  margin-top: 26rpx;
  border: 1rpx solid rgba(80, 62, 48, .035);
  border-radius: 31rpx;
  background: rgba(255, 255, 255, .95);
  box-shadow: 0 13rpx 36rpx rgba(89, 65, 47, .075);
}

.summary-card { padding: 31rpx 29rpx 25rpx; }
.summary-primary { min-height: 78rpx; justify-content: space-around; }
.primary-metric { min-width: 0; justify-content: center; flex: 1; }

.metric-icon {
  position: relative;
  width: 66rpx;
  height: 66rpx;
  margin-right: 18rpx;
  flex: none;
}

.bowl-icon { color: #f4a54d; }

.bowl-lid {
  position: absolute;
  top: 12rpx;
  left: 7rpx;
  width: 51rpx;
  height: 20rpx;
  border-radius: 27rpx 27rpx 3rpx 3rpx;
  background: currentColor;
}

.bowl-lid::before {
  position: absolute;
  top: -9rpx;
  left: 22rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: currentColor;
  content: '';
}

.bowl-body {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  width: 45rpx;
  height: 24rpx;
  border-radius: 3rpx 3rpx 24rpx 24rpx;
  background: currentColor;
}

.fire-icon {
  color: #ef7064;
  font-size: 60rpx;
  line-height: 57rpx;
  text-shadow: -8rpx -11rpx 0 #ff9c75;
  transform: rotate(-8deg) scale(.66, .9);
}

.metric-value {
  color: #19202a;
  font-size: 43rpx;
  font-weight: 750;
  line-height: 1;
  white-space: nowrap;
}

.metric-value text { margin-left: 9rpx; font-size: 26rpx; font-weight: 650; }
.metric-pending { color: #7e8185; font-size: 23rpx; line-height: 1.45; }
.metric-divider { width: 1rpx; height: 66rpx; flex: none; background: #ece9e5; }
.summary-rule { height: 1rpx; margin: 25rpx 0 24rpx; background: #ece9e5; }
.macro-list { justify-content: space-between; }

.macro-item {
  box-sizing: border-box;
  min-width: 0;
  width: 33.333%;
  justify-content: center;
  border-right: 1rpx solid #eeeae6;
  color: #273246;
  font-size: 30rpx;
  font-weight: 650;
  white-space: nowrap;
}

.macro-item:last-child { border-right: 0; }
.macro-item text { margin-left: 6rpx; font-size: 23rpx; font-weight: 500; }
.macro-dot { margin-right: 12rpx; font-size: 31rpx; line-height: 1; }
.protein-item .macro-dot { color: #81ce95; }
.fat-item .macro-dot { color: #f3b849; transform: rotate(13deg); }
.carbs-item .macro-dot { color: #9a8bea; text-shadow: 6rpx -4rpx 0 rgba(154, 139, 234, .35); }

.coverage {
  margin-top: 24rpx;
  color: #9a9895;
  font-size: 19rpx;
  line-height: 1.5;
  text-align: center;
}

.pending-copy { margin: 18rpx 10rpx 0; }

.guidance-card {
  position: relative;
  align-items: flex-start;
  min-height: 181rpx;
  padding: 29rpx 27rpx 24rpx;
  background: linear-gradient(115deg, rgba(247, 252, 247, .98), rgba(255, 254, 248, .98));
}

.plant-art {
  position: relative;
  width: 91rpx;
  height: 116rpx;
  margin: 8rpx 26rpx 0 2rpx;
  flex: none;
}

.plant-stem {
  position: absolute;
  left: 43rpx;
  bottom: 3rpx;
  width: 5rpx;
  height: 104rpx;
  border-radius: 3rpx;
  background: #927b5f;
  transform: rotate(13deg);
}

.plant-leaf {
  position: absolute;
  width: 46rpx;
  height: 24rpx;
  border-radius: 80% 12% 80% 12%;
  background: linear-gradient(135deg, #a8bf8e, #6f936b);
}

.plant-art .leaf-one { top: 6rpx; left: 30rpx; transform: rotate(99deg); }
.plant-art .leaf-two { top: 42rpx; right: 0; transform: rotate(153deg); }
.plant-art .leaf-three { top: 65rpx; left: 4rpx; transform: rotate(31deg); }
.guidance-copy { min-width: 0; flex: 1; }
.guidance-title { color: #252b34; font-size: 28rpx; font-weight: 700; line-height: 1.4; }
.guidance-text { margin-top: 10rpx; color: #7c838f; font-size: 24rpx; line-height: 1.55; }
.guidance-text + .guidance-text { margin-top: 7rpx; }

.guidance-disclaimer {
  margin-top: 12rpx;
  color: #aaa8a3;
  font-size: 18rpx;
  line-height: 1.45;
}

.primary-button,
.secondary-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 94rpx;
  margin-top: 27rpx;
  padding: 18rpx 24rpx;
  border-radius: 47rpx;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.35;
  transition: opacity .15s ease, transform .15s ease;
}

.primary-button {
  background: linear-gradient(100deg, #e45b58, #df6460);
  box-shadow: 0 12rpx 27rpx rgba(206, 83, 77, .18);
  color: #fff;
}

.secondary-button { margin-top: 16rpx; background: #fcedea; color: #7d4840; }
.primary-button-pressed, .secondary-button-pressed { opacity: .78; transform: scale(.988); }
.tap-target { transition: opacity .15s ease, background-color .15s ease; }
.tap-soft { opacity: .62; background: rgba(90, 78, 70, .07); }

@media (max-width: 340px) {
  .content { padding-right: 24rpx; padding-left: 24rpx; }
  .memory-heading { padding-right: 9rpx; padding-left: 16rpx; font-size: 35rpx; letter-spacing: 3rpx; }
  .heading-line-two { padding-left: 69rpx; }
  .heading-stroke { left: 20rpx; }
  .photo-collage { grid-template-rows: repeat(2, 202rpx); min-height: 414rpx; }
  .memory-note { padding-right: 14rpx; padding-left: 14rpx; font-size: 28rpx; }
  .summary-card { padding-right: 20rpx; padding-left: 20rpx; }
  .metric-icon { margin-right: 10rpx; transform: scale(.9); }
  .metric-value { font-size: 37rpx; }
  .metric-value text { margin-left: 5rpx; font-size: 22rpx; }
  .macro-dot { margin-right: 7rpx; }
  .macro-item { font-size: 27rpx; }
  .plant-art { margin-right: 18rpx; transform: scale(.9); transform-origin: left top; }
}
