.page {
  background: var(--bg);
}

.topbar {
  box-sizing: border-box;
  background: var(--bg);
}

.nav-row {
  display: flex;
  align-items: center;
  min-height: 44px;
  padding: 12rpx var(--gutter);
}

.nav-side, .nav-spacer {
  flex: none;
}

.nav-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 36px;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background: var(--glass);
}

.nav-action .ui-icon {
  width: 32rpx;
  height: 32rpx;
}

.nav-copy {
  min-width: 0;
  flex: 1;
  text-align: center;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
}

.nav-date {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.35;
}

.content {
  box-sizing: border-box;
  padding: 32rpx var(--gutter) calc(40rpx + env(safe-area-inset-bottom));
}

.memory-heading {
  margin-bottom: 32rpx;
  color: var(--ink);
  font-size: 38rpx;
  font-weight: 500;
  line-height: 1.6;
  letter-spacing: 1rpx;
}

.heading-heart {
  color: var(--quiet);
}

.collage-shell {
  position: relative;
}

.photo-collage {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-template-rows: repeat(2, calc((100vw - 104rpx) / 2));
  gap: 16rpx;
}

.recap-photo {
  display: block;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  border-radius: var(--radius-image);
  background: #f0e7dc;
}

.photo-pressed {
  opacity: .8;
}

.collage-1 .recap-photo {
  grid-column: 1 / -1;
  grid-row: 1 / -1;
}

.collage-2 {
  grid-template-rows: calc((100vw - 104rpx) / 2);
}

/* Preserve notes for sparse days without layering paper over the photos. */
.memory-note {
  grid-column: 1 / -1;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
  white-space: pre-line;
  padding-top: 8rpx;
}

.collage-1 {
  grid-template-rows: repeat(2, 236rpx);
}

.collage-3 .memory-note {
  display: flex;
  align-items: center;
  justify-content: center;
  grid-column: 2;
  grid-row: 2;
  padding: 24rpx;
  text-align: center;
}

.summary-card {
  margin-top: 24rpx;
}

.summary-primary, .primary-metric {
  display: flex;
  align-items: center;
}

.primary-metric {
  gap: 12rpx;
}

.metric-icon {
  width: 32rpx;
  height: 32rpx;
}

.metric-value {
  color: var(--muted);
  font-size: 26rpx;
}

.metric-value text {
  margin-left: 4rpx;
}

.action-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 32rpx;
}

.primary-button, .secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 44px;
  height: var(--control-height);
  margin: 0;
  padding: 0 24rpx;
  border-radius: var(--radius-control);
  font-size: var(--text-body);
  line-height: 1.3;
}

.primary-button {
  background: var(--brand);
  color: var(--surface);
  font-weight: 600;
}

.secondary-button {
  background: transparent;
  color: var(--muted);
}

.button-arrow {
  width: 32rpx;
  height: 32rpx;
  margin-left: 12rpx;
}

.primary-button-pressed, .secondary-button-pressed {
  opacity: .7;
}

.footer-note {
  margin-top: 16rpx;
  color: var(--quiet);
  font-size: 22rpx;
  text-align: center;
}

@media (max-width: 340px) { .memory-heading { font-size: 34rpx; } }
