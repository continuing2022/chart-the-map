<view wx:if="{{recap}}" class="page">
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-row">
      <view class="nav-side" style="width: {{navSideWidth}}px;">
        <view class="nav-action tap-target" hover-class="tap-soft" bindtap="close" aria-role="button" aria-label="关闭回顾">
          <image class="ui-icon" src="/assets/icons/close.svg" mode="aspectFit" aria-hidden="true" />
        </view>
      </view>
      <view class="nav-copy">
        <view class="nav-title-wrap">
          <view class="nav-title">{{title}}</view>
        </view>
        <view class="nav-date">{{dateLabel}} · {{weekdayLabel}}</view>
      </view>
      <view class="nav-spacer" style="width: {{navSideWidth}}px;"></view>
    </view>
  </view>

  <view class="content">
    <view class="memory-heading">今天，也有好好吃饭 <text class="heading-heart">♡</text></view>

    <view class="collage-shell">
      <view class="photo-collage collage-{{recap.recordedMeals}}">
        <image
          wx:for="{{recap.records}}"
          wx:for-item="record"
          wx:key="id"
          class="recap-photo {{record.photoClass}}"
          src="{{record.imageSource}}"
          mode="aspectFill"
          data-id="{{record.id}}"
          bindtap="openDetail"
          hover-class="photo-pressed"
          aria-role="button"
          aria-label="查看这餐详情"
        />
        <view wx:if="{{collageNote}}" class="memory-note" aria-hidden="true">
          <text>{{collageNote}}</text>
        </view>
      </view>
    </view>

    <view class="summary-card">
      <view class="summary-item"><view class="metric-value">{{recap.recordedMeals}}<text>餐</text></view><view class="metric-label">今日记录</view></view>
      <view class="summary-item"><view class="metric-value">{{photoCount}}<text>张</text></view><view class="metric-label">食光照片</view></view>
      <view class="summary-item"><view class="metric-value">{{noteCount}}<text>条</text></view><view class="metric-label">今日小记</view></view>
    </view>

    <view class="journal-card day-note-card">
      <view class="journal-card-title">今日一句</view>
      <view wx:if="{{dayNotes.length}}" class="day-notes">
        <view wx:for="{{dayNotes}}" wx:key="id" class="day-note tap-target" data-id="{{item.id}}" bindtap="openDetail" hover-class="tap-soft" aria-role="button" aria-label="查看{{item.slotLabel}}小记">
          <text class="note-slot">{{item.slotLabel}}</text>
          <text class="journal-copy">{{item.note}}</text>
        </view>
      </view>
      <view wx:else class="journal-copy journal-placeholder empty-note">写一句话，记住今天的味道 ♡</view>
      <view wx:if="{{!dayNotes.length}}" class="note-hint">在餐食详情里，为这一餐留下小记</view>
    </view>

    <view class="action-row">
      <button class="primary-button" hover-class="primary-button-pressed" bindtap="openDateRecords">{{primaryActionLabel}}</button>
    </view>
    <view class="footer-note" aria-hidden="true">生活很简单，一日三餐 ♡</view>
  </view>
</view>
