.page { padding: 52rpx 32rpx; }.title { font-size: 54rpx; font-weight: 700; letter-spacing: -2rpx; }.subtitle { margin: 12rpx 0 44rpx; color: #8e8e93; font-size: 26rpx; }.section { margin-bottom: 22rpx; padding: 30rpx; background: #fff; border-radius: 28rpx; }.section-title { font-size: 29rpx; font-weight: 700; }.style-list { display: flex; gap: 16rpx; margin-top: 24rpx; }.style-pill { flex: 1; padding: 20rpx 8rpx; border-radius: 20rpx; background: #f3f3f6; color: #77777e; text-align: center; font-size: 25rpx; }.style-pill.selected { background: #e9efff; color: #4564b9; font-weight: 600; }.hint { margin-top: 16rpx; color: #8e8e93; font-size: 22rpx; line-height: 1.55; }.link-row { display: flex; align-items: center; justify-content: space-between; }.chevron { color: #8e8e93; font-size: 40rpx; }.footer { margin-top: 60rpx; color: #b1b1b6; text-align: center; font-size: 22rpx; }
