.page { padding: 52rpx 32rpx; }.title { font-size: 54rpx; font-weight: 700; letter-spacing: -2rpx; }.subtitle { margin: 12rpx 0 44rpx; color: #8e8e93; font-size: 26rpx; }.section { margin-bottom: 22rpx; padding: 30rpx; background: #fff; border-radius: 28rpx; box-shadow: 0 10rpx 28rpx rgba(250,160,0,.07); }.section-title { font-size: 29rpx; font-weight: 700; }.style-list { display: flex; gap: 16rpx; margin-top: 24rpx; }.style-pill { flex: 1; padding: 20rpx 8rpx; border-radius: 20rpx; background: rgba(250,230,83,.22); color: #6e6e73; text-align: center; font-size: 25rpx; }.style-pill.selected { background: #fabf00; color: #1d1d1f; font-weight: 700; box-shadow: 0 6rpx 18rpx rgba(250,160,0,.18); }.hint { margin-top: 16rpx; color: #8e8e93; font-size: 22rpx; line-height: 1.55; }.link-row { display: flex; align-items: center; justify-content: space-between; }.chevron { color: #a86b00; font-size: 40rpx; }.footer { margin-top: 60rpx; color: #9b8b55; text-align: center; font-size: 22rpx; }
