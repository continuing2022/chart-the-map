.page {
  box-sizing: border-box;
  padding: 28rpx var(--gutter) calc(40rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

.subtitle {
  margin-bottom: var(--space-section);
  color: var(--muted);
  font-size: var(--text-body);
}

.section {
  margin-bottom: var(--space-section);
}

.section-heading, .section-heading-main, .style-list, .privacy-link, .privacy-row {
  display: flex;
  align-items: center;
}

.section-heading {
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: var(--text-section);
  font-weight: 600;
  letter-spacing: -1rpx;
}

.style-list {
  gap: 16rpx;
  align-items: stretch;
}

.style-card {
  position: relative;
  box-sizing: border-box;
  width: calc(33.333% - 11rpx);
  min-width: 0;
  padding: 12rpx 8rpx 16rpx;
  border: 2rpx solid transparent;
  border-radius: var(--radius-image);
  text-align: center;
}

.style-illustration {
  background: #f1f0e7;
}

.style-clay {
  background: #f5ede4;
}

.style-comic {
  background: var(--brand-soft);
}

.style-card.selected {
  border-color: rgba(239, 98, 94, .55);
  color: var(--brand);
}

.style-card-pressed {
  opacity: .7;
}

.style-art {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  margin: 0 auto 8rpx;
  transform: scale(.85);
  transform-origin: center;
}

.style-name {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
}

.selected-mark {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: var(--brand);
  color: var(--surface);
  font-size: 18rpx;
  line-height: 1;
}

.hint {
  margin-top: 20rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
}

/* 插画风：扁平线条猫咪 */
.cat-ear {
  position: absolute;
  z-index: 1;
  top: 18rpx;
  width: 40rpx;
  height: 43rpx;
  border: 4rpx solid #a87354;
  border-radius: 10rpx 25rpx 8rpx 20rpx;
  background: #f6c99f;
  transform: rotate(45deg);
}

.cat-ear::after {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 4rpx 10rpx 3rpx 8rpx;
  background: #ed9c91;
  content: '';
}

.cat-ear-left {
  left: 11rpx;
}

.cat-ear-right {
  right: 11rpx;
  transform: rotate(45deg) scale(-1, -1);
}


.cat-face {
  position: absolute;
  z-index: 2;
  left: 7rpx;
  right: 7rpx;
  bottom: 9rpx;
  height: 69rpx;
  border: 4rpx solid #a87354;
  border-radius: 48% 48% 44% 44%;
  background: #fffaf5;
  color: #76513d;
}

.cat-eye,
.bear-eye,
.girl-eye,
.girl-cheek {
  position: absolute;
}

.cat-eye {
  top: 24rpx;
  font-size: 22rpx;
}

.cat-eye.left {
  left: 24rpx;
}

.cat-eye.right {
  right: 24rpx;
}

.cat-mouth {
  display: block;
  padding-top: 33rpx;
  font-size: 22rpx;
  font-weight: 700;
}


.cat-whisker {
  position: absolute;
  top: 38rpx;
  font-size: 17rpx;
  font-weight: 700;
}

.whisker-left {
  left: -13rpx;
  transform: rotate(6deg);
}

.whisker-right {
  right: -13rpx;
  transform: rotate(174deg);
}


/* 黏土风：柔软立体小熊 */
.bear-ear {
  position: absolute;
  z-index: 1;
  top: 19rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #e3aa75, #bd7d4c);
  box-shadow: inset 0 0 0 9rpx rgba(246, 194, 145, .42);
}

.bear-ear-left {
  left: 13rpx;
}

.bear-ear-right {
  right: 13rpx;
}


.bear-face {
  position: absolute;
  z-index: 2;
  left: 9rpx;
  right: 9rpx;
  bottom: 7rpx;
  height: 75rpx;
  border-radius: 48% 48% 44% 44%;
  background: linear-gradient(145deg, #e9b681 5%, #c98c58 78%);
  box-shadow: inset -8rpx -8rpx 14rpx rgba(139, 84, 44, .10), 0 7rpx 10rpx rgba(154, 99, 57, .13);
  color: #684126;
}

.bear-eye {
  top: 26rpx;
  font-size: 20rpx;
}

.bear-eye.left {
  left: 24rpx;
}

.bear-eye.right {
  right: 24rpx;
}


.bear-muzzle {
  width: 41rpx;
  height: 28rpx;
  margin: 36rpx auto 0;
  border-radius: 50%;
  background: rgba(250, 220, 187, .77);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 25rpx;
}

/* 漫画风：圆润头像 */
.girl-hair {
  position: absolute;
  z-index: 1;
  left: 8rpx;
  right: 8rpx;
  bottom: 5rpx;
  height: 88rpx;
  border-radius: 48% 48% 38% 38%;
  background: #91604e;
  box-shadow: -8rpx 16rpx 0 -1rpx #91604e, 8rpx 16rpx 0 -1rpx #91604e;
}

.girl-hair::before,
.girl-hair::after {
  position: absolute;
  top: 8rpx;
  width: 43rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #76503f;
  content: '';
}

.girl-hair::before {
  left: -9rpx;
}

.girl-hair::after {
  right: -9rpx;
}


.girl-face {
  position: absolute;
  z-index: 2;
  left: 21rpx;
  right: 21rpx;
  bottom: 16rpx;
  height: 66rpx;
  border-radius: 45% 45% 48% 48%;
  background: #ffe2cf;
  color: #68453a;
}

.girl-face::before {
  position: absolute;
  top: -11rpx;
  left: -1rpx;
  width: 61rpx;
  height: 26rpx;
  border-radius: 50% 50% 37% 37%;
  background: #76503f;
  content: '';
}

.girl-eye {
  top: 28rpx;
  font-size: 18rpx;
}

.girl-eye.left {
  left: 15rpx;
}

.girl-eye.right {
  right: 15rpx;
}

.girl-smile {
  display: block;
  padding-top: 40rpx;
  font-size: 17rpx;
  font-weight: 700;
}


.girl-cheek {
  top: 43rpx;
  width: 12rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(238, 129, 128, .45);
}

.girl-cheek.left {
  left: 9rpx;
}

.girl-cheek.right {
  right: 9rpx;
}



.privacy-link {
  min-height: 44px;
  padding-left: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.privacy-link .ui-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 4rpx;
}

.privacy-link-pressed {
  opacity: .65;
}

.privacy-list {
  padding: 0 24rpx;
  border-radius: var(--radius-card);
  background: var(--surface);
}

.privacy-row {
  box-sizing: border-box;
  min-height: 128rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.privacy-row:last-child {
  border-bottom: 0;
}

.row-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  margin-right: 20rpx;
  flex: none;
}

.row-icon .ui-icon {
  width: 36rpx;
  height: 36rpx;
}

.row-copy {
  min-width: 0;
  flex: 1;
}

.row-title {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.4;
}

.row-description {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.footer-art {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
}

.footer-copy {
  color: var(--quiet);
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 24rpx;
}

.plant {
  position: relative;
  width: 70rpx;
  height: 88rpx;
  flex: none;
  opacity: .55;
  transform: rotate(12deg);
}

.stem {
  position: absolute;
  left: 34rpx;
  bottom: 0;
  width: 3rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #99a388;
  transform: rotate(16deg);
}

.leaf {
  position: absolute;
  width: 28rpx;
  height: 16rpx;
  border-radius: 80% 12% 80% 12%;
  background: #9da98e;
}

.leaf-one {
  top: 10rpx;
  left: 24rpx;
  transform: rotate(102deg);
}

.leaf-two {
  top: 30rpx;
  right: 1rpx;
  transform: rotate(151deg);
}

.leaf-three {
  top: 50rpx;
  left: 9rpx;
  transform: rotate(35deg);
}

.leaf-four {
  top: 60rpx;
  right: 3rpx;
  transform: rotate(152deg);
}

@media (max-width: 340px) { .privacy-list { padding: 0 20rpx; } .row-icon { margin-right: 16rpx; } }
