.page { padding: 52rpx 32rpx 70rpx; }
.title { font-size: 54rpx; font-weight: 700; letter-spacing: -2rpx; }
.subtitle { margin: 12rpx 0 32rpx; color: #8e8e93; font-size: 26rpx; line-height: 1.5; }
.date-picker { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; padding: 24rpx 26rpx; background: rgba(250,230,83,.34); border-radius: 26rpx; }
.picker-label { color: #8e8e93; font-size: 21rpx; }
.picker-date { margin-top: 5rpx; font-size: 29rpx; font-weight: 700; }
.picker-action,.recap-link { color: #895800; font-size: 23rpx; font-weight: 600; }
.day-card { margin-bottom: 30rpx; padding: 26rpx; background: #fff; border-radius: 28rpx; box-shadow: 0 10rpx 28rpx rgba(250,160,0,.07); }
.day-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.day-title,.recorded-title { font-size: 28rpx; font-weight: 700; }
.history-row { display: flex; align-items: center; padding: 13rpx 0; }
.history-row.empty-row { border-radius: 20rpx; }
.thumb { width: 76rpx; height: 76rpx; border-radius: 18rpx; background: rgba(250,230,83,.24); }
.placeholder { display: flex; align-items: center; justify-content: center; color: #a86b00; font-size: 32rpx; }
.history-label { flex: 1; margin-left: 18rpx; font-size: 26rpx; }
.muted { color: #9999a0; font-size: 23rpx; }
.recorded-section { padding-bottom: 30rpx; }
.recorded-title { margin-bottom: 16rpx; }
.date-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.date-chip { padding: 13rpx 18rpx; border-radius: 18rpx; background: rgba(255,255,255,.72); color: #77777e; font-size: 22rpx; }
.date-chip.selected { background: #fabf00; color: #1d1d1f; font-weight: 600; }
