.page { padding: 52rpx 32rpx; }.title { font-size: 54rpx; font-weight: 700; letter-spacing: -2rpx; }.subtitle { margin: 12rpx 0 44rpx; color: #8e8e93; font-size: 26rpx; }.empty { margin-top: 120rpx; text-align: center; color: #5e5e64; font-size: 29rpx; }.empty-icon { margin-bottom: 20rpx; color: #faa000; font-size: 68rpx; }.empty-sub { margin-top: 12rpx; color: #9999a0; font-size: 24rpx; }.day-card { margin-bottom: 22rpx; padding: 26rpx; background: #fff; border-radius: 28rpx; box-shadow: 0 10rpx 28rpx rgba(250,160,0,.07); }.day-title { margin-bottom: 15rpx; font-size: 28rpx; font-weight: 700; }.history-row { display: flex; align-items: center; padding: 13rpx 0; }.thumb { width: 76rpx; height: 76rpx; border-radius: 18rpx; background: rgba(250,230,83,.24); }.placeholder { display: flex; align-items: center; justify-content: center; color: #a86b00; font-size: 32rpx; }.history-label { flex: 1; margin-left: 18rpx; font-size: 26rpx; }.muted { color: #9999a0; font-size: 23rpx; }
