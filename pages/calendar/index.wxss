.page {
  box-sizing: border-box;
  min-height: calc(100vh - var(--navigation-total));
  padding: 32rpx var(--gutter) calc(152rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.header-copy {
  min-width: 0;
  flex: 1;
}

.title {
  font-size: var(--text-page);
  font-weight: 650;
  letter-spacing: -2rpx;
  line-height: 1.2;
}

.subtitle {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.calendar-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  margin-left: 12rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background: var(--glass);
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 376rpx;
  max-width: 100%;
  box-sizing: border-box;
  margin: 0 auto 32rpx;
  padding: 2rpx 6rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background: var(--glass);
  box-shadow: 0 6rpx 24rpx rgba(75, 58, 43, .04);
  backdrop-filter: blur(8px);
}

.month-control {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  flex: none;
}

.month-control .ui-icon {
  width: 32rpx;
  height: 32rpx;
}

.month-control.disabled {
  opacity: .28;
}

.month-picker {
  min-width: 0;
  flex: 1;
}

.month-label {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  font-size: 30rpx;
  font-weight: 600;
}

.day-card {
  padding: 0 0 24rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.day-card:last-child {
  margin-bottom: 0;
  border-bottom: 0;
}

.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.day-date {
  display: flex;
  align-items: baseline;
  flex: none;
}

.day-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.3;
}

.weekday {
  margin-left: 16rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.meal-grid {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.meal-slot {
  width: calc(25% - 12rpx);
  min-width: 0;
  text-align: center;
}

.thumb-shell {
  width: 100%;
  height: calc((100vw - 136rpx) / 4);
  overflow: hidden;
  border-radius: var(--radius-image);
}

.thumb {
  display: block;
  width: 100%;
  height: 100%;
  background: #f4ece3;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3ede4;
}

.placeholder .ui-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: .48;
}

.placeholder-lunch {
  background: #edf0e8;
}

.placeholder-dinner {
  background: #f6ece9;
}

.placeholder-late-night {
  background: var(--surface);
}

.meal-label {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.35;
}

.meal-status {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
  color: var(--quiet);
  font-size: 22rpx;
  line-height: 1.3;
}

.status-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 6rpx;
  box-sizing: border-box;
  border: 1rpx solid currentColor;
  border-radius: 50%;
}

.recorded {
  color: var(--success);
}

.recorded .status-dot {
  background: currentColor;
}

.day-note {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  min-height: 44px;
  flex: 1;
  margin-left: 12rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.4;
}

.note-chevron {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
  opacity: .6;
}

.empty-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 56rpx 0 24rpx;
  text-align: center;
}

.empty-art {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 152rpx;
  height: 152rpx;
  margin-bottom: 32rpx;
  border-radius: 50%;
  background: #f2ebe1;
}

.empty-art image {
  width: 72rpx;
  height: 72rpx;
  opacity: .65;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
}

.empty-copy {
  margin-top: 16rpx;
  color: var(--muted);
  font-size: var(--text-body);
  line-height: 1.7;
}

.today-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 320rpx;
  min-height: 44px;
  height: var(--control-height);
  margin-top: 32rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-control);
  background: var(--brand);
  color: var(--surface);
  font-size: var(--text-body);
  font-weight: 600;
}

.today-button-active {
  opacity: .75;
}



.day-note > text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-chevron {
  flex: none;
}
