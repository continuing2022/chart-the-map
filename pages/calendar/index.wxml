<app-nav status-bar-height="{{statusBarHeight}}" navigation-bar-height="{{navigationBarHeight}}" right-safe-width="{{navigationRightInset}}"></app-nav>
<view class="page {{showEmptyState ? 'is-empty' : ''}}" style="--navigation-total: {{navigationTotalHeight}}px;">
  <view class="calendar-header">
    <view class="header-copy"><view class="title">日历</view><view class="subtitle">每一餐，都是生活的一小段回忆</view></view>
    <picker mode="date" value="{{selectedDateKey}}" end="{{todayKey}}" bindchange="chooseDate">
      <view class="calendar-button tap-target" hover-class="tap-soft" aria-role="button" aria-label="选择具体日期"><image class="ui-icon" src="/assets/icons/calendar.svg" mode="aspectFit" aria-hidden="true" /></view>
    </picker>
  </view>
  <view class="month-nav">
    <view class="month-control tap-target" hover-class="tap-soft" bindtap="showPreviousMonth" aria-role="button" aria-label="上一个月"><image class="ui-icon" src="/assets/icons/chevron-left.svg" mode="aspectFit" aria-hidden="true" /></view>
    <picker class="month-picker" mode="date" fields="month" value="{{selectedMonthKey}}-01" end="{{todayKey}}" bindchange="chooseMonth"><view class="month-label tap-target" hover-class="tap-soft">{{monthLabel}}</view></picker>
    <view class="month-control {{canGoNextMonth ? '' : 'disabled'}} tap-target" hover-class="{{canGoNextMonth ? 'tap-soft' : ''}}" bindtap="showNextMonth" aria-role="button" aria-disabled="{{!canGoNextMonth}}" aria-label="下一个月"><image class="ui-icon" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true" /></view>
  </view>
  <view wx:if="{{days.length}}" class="day-list">
    <view wx:for="{{days}}" wx:for-item="day" wx:key="dateKey" class="day-card">
      <view class="day-head">
        <view class="day-date"><text class="day-title">{{day.dateTitle}}</text><text class="weekday">{{day.weekdayLabel}}</text></view>
      <view wx:if="{{day.hasRecords}}" class="day-note tap-target" hover-class="tap-soft" catchtap="openRecap" data-date-key="{{day.dateKey}}" aria-role="button" aria-label="查看{{day.dateTitle}}食光回顾"><text>{{day.note}}</text><image class="note-chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true" /></view>
      <view wx:else class="day-note">为这天留下一点食光</view>
      </view>
      <view class="meal-grid">
        <view wx:for="{{day.slots}}" wx:for-item="slot" wx:key="key" class="meal-slot {{slot.record ? 'has-record' : 'is-missing'}} tap-card" hover-class="tap-card-active" bindtap="chooseSource" data-slot="{{slot}}" data-date-key="{{day.dateKey}}" data-id="{{slot.record ? slot.record.id : ''}}" aria-role="button" aria-label="{{day.dateTitle}}{{slot.label}}，{{slot.record ? '查看记录' : '补记餐食'}}">
          <view class="thumb-shell">
            <image wx:if="{{slot.record}}" class="thumb" src="{{slot.imageSource}}" mode="aspectFill" />
            <view wx:else class="thumb placeholder placeholder-{{slot.accent}}"><image class="ui-icon" src="/assets/icons/{{slot.key === 'breakfast' ? 'sun' : (slot.key === 'lunch' ? 'bowl' : (slot.key === 'dinner' ? 'heart' : 'star'))}}.svg" mode="aspectFit" aria-hidden="true" /></view>
          </view>
          <view class="meal-label">{{slot.label}}</view>
          <view class="meal-status {{slot.record ? 'recorded' : ''}}"><text class="status-dot"></text>{{slot.record ? '已记录' : '未记录'}}</view>
        </view>
      </view>

    </view>
  </view>
  <view wx:if="{{showEmptyState}}" class="empty-state">
    <view class="empty-art" aria-hidden="true"><image src="/assets/icons/bowl.svg" mode="aspectFit" /></view>
    <view class="empty-title">从一餐开始，收藏食光</view>
    <view class="empty-copy">还没有记录，<br/>回到「今天」，从第一餐开始吧。</view>
    <button class="today-button" hover-class="today-button-active" bindtap="backToToday">回到今天</button>
  </view>
</view>
