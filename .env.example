# Reference only: export these variables in the deployment platform.
NODE_ENV=production
PORT=3000
AUTH_MODE=wechat
ALLOW_LOCAL_POC_PROVIDER=false
PUBLIC_BASE_URL=https://meal-api.example.com
WECHAT_APP_ID=replace-in-secret-manager
WECHAT_APP_SECRET=replace-in-secret-manager
TOKEN_SECRET=generate-at-least-32-random-bytes
ASSET_SIGNING_SECRET=generate-a-different-random-secret
SESSION_TTL_MS=900000
ASSET_URL_TTL_MS=600000
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_DIMENSION=6000
MUTATION_LIMIT_PER_MINUTE=60
POC_BUDGET_CNY=100
STYLIZATION_COST_CNY=0.1
NUTRITION_COST_CNY=0.02
TASK_DELAY_MS=500
