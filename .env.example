# Reference only: export these variables in the deployment platform.
NODE_ENV=production
PORT=3000
AUTH_MODE=wechat
ALLOW_LOCAL_POC_PROVIDER=false
AI_PROVIDER=tokenhub
TOKENHUB_API_KEY=replace-in-secret-manager
TOKENHUB_GENERATION_TIMEOUT_MS=300000
# Legacy hunyuan API is retired. COS credentials below are for storage only.
# Optional dedicated credentials. When omitted, reuse COS_SECRET_ID/COS_SECRET_KEY.
# HUNYUAN_SECRET_ID=replace-in-secret-manager
# HUNYUAN_SECRET_KEY=replace-in-secret-manager
HUNYUAN_REGION=ap-guangzhou
HUNYUAN_REQUEST_TIMEOUT_MS=30000
HUNYUAN_POLL_INTERVAL_MS=3000
HUNYUAN_TASK_TIMEOUT_MS=600000
PUBLIC_BASE_URL=https://meal-api.example.com
WECHAT_APP_ID=replace-in-secret-manager
WECHAT_APP_SECRET=replace-in-secret-manager
TOKEN_SECRET=generate-at-least-32-random-bytes
ASSET_SIGNING_SECRET=generate-a-different-random-secret
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=false
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=10000
ASSET_STORAGE=cos
COS_BUCKET=shiguang-diary-images-your-appid
COS_REGION=ap-guangzhou
COS_SECRET_ID=replace-in-secret-manager
COS_SECRET_KEY=replace-in-secret-manager
COS_KEY_PREFIX=private
COS_TIMEOUT_MS=15000
SESSION_TTL_MS=900000
ASSET_URL_TTL_MS=600000
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_DIMENSION=6000
MUTATION_LIMIT_PER_MINUTE=60
POC_BUDGET_CNY=100
STYLIZATION_COST_CNY=0.1
NUTRITION_COST_CNY=0.02
TASK_DELAY_MS=500
