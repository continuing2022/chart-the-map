@import "../../styles/design-system.wxss";
.custom-nav {
  position: relative;
  z-index: 20;
  box-sizing: content-box;
  background: var(--bg);
}

.nav-inner {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  padding-left: var(--gutter);
}

.nav-brand-group {
  display: flex;
  justify-content: center;
  flex-direction: column;
}

.nav-brand {
  color: var(--ink);
  font-family: "STKaiti", "KaiTi", "PingFang SC", serif;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.15;
}

.nav-spark {
  margin-left: 6rpx;
  color: var(--accent);
  font-size: 14rpx;
  vertical-align: top;
}

.nav-subtitle {
  margin-top: 4rpx;
  color: var(--quiet);
  font-size: 18rpx;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.settings {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 36px;
  margin-left: auto;
  flex: none;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background: var(--glass);
  box-shadow: 0 4rpx 16rpx rgba(75, 58, 43, .04);
  backdrop-filter: blur(10px);
}

.settings image {
  width: 36rpx;
  height: 36rpx;
}
