.custom-nav {
  position: relative;
  z-index: 20;
  box-sizing: content-box;
  background: rgba(255, 251, 246, .96);
}

.custom-nav::after {
  position: absolute;
  right: 30rpx;
  bottom: 0;
  left: 30rpx;
  height: 1rpx;
  opacity: .55;
  background: linear-gradient(90deg, transparent, #efddd2 18%, #efddd2 70%, transparent);
  content: '';
}

.nav-inner {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  padding-left: 38rpx;
}

.nav-brand-group {
  display: flex;
  justify-content: center;
  height: 100%;
  flex-direction: column;
}

.nav-brand {
  position: relative;
  flex: none;
  color: #302621;
  font-family: "STKaiti", "KaiTi", "PingFang SC", sans-serif;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  line-height: 1;
}

.nav-spark {
  margin-left: 5rpx;
  color: #f49a35;
  font-size: 19rpx;
  vertical-align: top;
}

.nav-swash {
  width: 190rpx;
  height: 11rpx;
  margin-top: -6rpx;
  border-radius: 50%;
  background: rgba(242, 130, 126, .3);
  transform: rotate(-2deg);
}

.nav-subtitle {
  margin-top: 2rpx;
  padding-left: 8rpx;
  color: #81746e;
  font-size: 12rpx;
  letter-spacing: 7rpx;
}

.settings {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin-left: auto;
  flex: none;
  border: 1rpx solid rgba(96, 79, 68, .1);
  border-radius: 50%;
  background: rgba(255, 255, 255, .8);
  box-shadow: 0 6rpx 16rpx rgba(85, 64, 50, .08);
}

.settings image {
  width: 34rpx;
  height: 34rpx;
}

.tap-target {
  transition: opacity .15s ease, transform .15s ease, background-color .15s ease;
}

.tap-soft {
  opacity: .62;
  background: rgba(90, 78, 70, .07);
}

@media (max-width: 340px) {
  .nav-inner { padding-left: 25rpx; }
  .nav-subtitle { letter-spacing: 5rpx; }
}
